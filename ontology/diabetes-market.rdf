<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:dcterms="http://purl.org/dc/terms/"
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:skos="http://www.w3.org/2004/02/skos/core#"
  xmlns:dm="https://dgg32.github.io/glp/ontology#"
>
  <owl:ObjectProperty rdf:about="http://www.w3.org/2004/02/skos/core#broader">
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="http://www.w3.org/2004/02/skos/core#broaderTransitive">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:label xml:lang="en">has broader transitive</rdfs:label>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2004/02/skos/core"/>
      </owl:ObjectProperty>
    </rdfs:subPropertyOf>
    <rdfs:label xml:lang="en">has broader</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2004/02/skos/core"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://dgg32.github.io/glp/ontology#npi">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">NPI</rdfs:label>
    <rdfs:domain rdf:resource="https://dgg32.github.io/glp/ontology#HealthcareProfessional"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">US National Provider Identifier (10 digits).</skos:definition>
    <rdfs:comment xml:lang="en">Privacy by design: never written to the generated RDF. Prescribers are identified by dm:pseudonymousId instead.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://dgg32.github.io/glp/ontology#totalDrugCost">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">total drug cost (USD)</rdfs:label>
    <rdfs:domain rdf:resource="https://dgg32.github.io/glp/ontology#Prescription"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <skos:definition xml:lang="en">Aggregate gross drug cost paid by Part D plan, beneficiary and other payers, in US dollars (CMS Tot_Drug_Cst).</skos:definition>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://dgg32.github.io/glp/ontology#cmsGenericName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">CMS generic name</rdfs:label>
    <rdfs:domain rdf:resource="https://dgg32.github.io/glp/ontology#MedicinalProduct"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">Generic name exactly as spelled in the CMS data (Gnrc_Name), e.g. 'Dapaglifloz Propaned/Metformin'.</skos:definition>
  </owl:DatatypeProperty>
  <owl:Ontology rdf:about="https://dgg32.github.io/glp/ontology">
    <dcterms:title xml:lang="en">Diabetes Drug Market Ontology</dcterms:title>
    <dcterms:title xml:lang="ja">糖尿病治療薬市場オントロジー</dcterms:title>
    <dcterms:title xml:lang="zh">糖尿病药物市场本体</dcterms:title>
    <dcterms:description xml:lang="en">A small OWL ontology for US Medicare Part D prescribing of type 2 diabetes drugs: who prescribes which product, containing which substance, in which therapeutic class. Product and substance classes are aligned to IDMP-O 1.4.0; commercial concepts (prescriber, prescription aggregate) are not covered by IDMP-O and are defined here.</dcterms:description>
    <dcterms:creator>Sixing Huang</dcterms:creator>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-14</dcterms:created>
    <dcterms:license rdf:resource="https://opensource.org/licenses/MIT"/>
    <owl:versionIRI rdf:resource="https://dgg32.github.io/glp/ontology/0.4.0"/>
    <owl:versionInfo>0.4.0</owl:versionInfo>
    <owl:priorVersion rdf:resource="https://dgg32.github.io/glp/ontology/0.3.0"/>
    <skos:changeNote xml:lang="en">0.4.0 (2026-10-15): definitions only, no axiom changes. dm:Indication: indications are MeSH descriptors stated in FDA labels (example 'obesity' replaces 'chronic weight management'). dm:Organization: a company is the corporate group of a Drugs@FDA application holder, identified by the LEI of its GLEIF ultimate parent.</skos:changeNote>
    <skos:changeNote xml:lang="en">0.3.0 (2026-10-14): added dm:pseudonymousId (prescribers are identified by a keyed hash, never by NPI or name, in loaded data) and dm:cmsGenericName.</skos:changeNote>
    <skos:changeNote xml:lang="en">0.2.0 (2026-10-14): removed the age 65+ datatype properties to stay well inside the Stardog Cloud Free 1M-edge limit; dm:writes is now inferred only; IDMP-O definitions moved to imports/idmp-o-1.4.0-extract.ttl.</skos:changeNote>
    <rdfs:comment xml:lang="en">IDMP-O and OMG Commons terms are referenced, not imported. The few external terms used are declared below (label + isDefinedBy only), following the MIREOT approach that IDMP-O itself adopted in release 1.8.0. Load the full IDMP-O into its own named graph if its axioms are needed.</rdfs:comment>
  </owl:Ontology>
  <owl:ObjectProperty rdf:about="https://dgg32.github.io/glp/ontology#hasPrimarySpecialty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="https://dgg32.github.io/glp/ontology#hasSpecialty">
        <rdfs:label xml:lang="en">has specialty</rdfs:label>
        <rdfs:domain rdf:resource="https://dgg32.github.io/glp/ontology#HealthcareProfessional"/>
        <rdfs:range rdf:resource="https://dgg32.github.io/glp/ontology#Specialty"/>
      </owl:ObjectProperty>
    </rdfs:subPropertyOf>
    <rdfs:label xml:lang="en">has primary specialty</rdfs:label>
    <rdfs:comment xml:lang="en">The NPI Registry taxonomy flagged primary.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://dgg32.github.io/glp/ontology#totalDaySupply">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">total day supply</rdfs:label>
    <rdfs:domain rdf:resource="https://dgg32.github.io/glp/ontology#Prescription"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://dgg32.github.io/glp/ontology#cmsPrescriberType">
    <rdfs:label xml:lang="en">CMS prescriber type</rdfs:label>
    <rdfs:domain rdf:resource="https://dgg32.github.io/glp/ontology#HealthcareProfessional"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">Specialty as reported by CMS (Prscrbr_Type), a free-text label that differs from the NUCC code.</skos:definition>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://dgg32.github.io/glp/ontology#GLP1Prescriber">
    <rdfs:label xml:lang="en">GLP-1 receptor agonist prescriber</rdfs:label>
    <rdfs:label xml:lang="ja">GLP-1受容体作動薬処方医</rdfs:label>
    <rdfs:label xml:lang="zh">GLP-1受体激动剂处方者</rdfs:label>
    <skos:definition xml:lang="en">A healthcare professional who wrote at least one prescription for a product containing a substance in the GLP-1 receptor agonist class (including narrower classes such as dual GIP/GLP-1 agonists).</skos:definition>
    <owl:equivalentClass>
      <owl:Class rdf:nodeID="nfccfa9717b284cdcbbfedaf39b72b723b8">
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://dgg32.github.io/glp/ontology#HealthcareProfessional"/>
          <owl:Restriction rdf:nodeID="nfccfa9717b284cdcbbfedaf39b72b723b9">
            <owl:onProperty>
              <owl:ObjectProperty rdf:about="https://dgg32.github.io/glp/ontology#writes">
                <rdfs:label xml:lang="en">writes</rdfs:label>
                <rdfs:comment xml:lang="en">Not stored in the data: only dm:prescribedBy is asserted and dm:writes is inferred through owl:inverseOf (saves one triple per prescription). Queries without reasoning must use ^dm:prescribedBy.</rdfs:comment>
                <rdfs:domain rdf:resource="https://dgg32.github.io/glp/ontology#HealthcareProfessional"/>
                <rdfs:range rdf:resource="https://dgg32.github.io/glp/ontology#Prescription"/>
                <owl:inverseOf rdf:resource="https://dgg32.github.io/glp/ontology#prescribedBy"/>
              </owl:ObjectProperty>
            </owl:onProperty>
            <owl:someValuesFrom>
              <owl:Restriction rdf:nodeID="nfccfa9717b284cdcbbfedaf39b72b723b10">
                <owl:onProperty rdf:resource="https://dgg32.github.io/glp/ontology#forProduct"/>
                <owl:someValuesFrom>
                  <owl:Restriction rdf:nodeID="nfccfa9717b284cdcbbfedaf39b72b723b11">
                    <owl:onProperty rdf:resource="https://dgg32.github.io/glp/ontology#hasActiveSubstance"/>
                    <owl:someValuesFrom>
                      <owl:Restriction rdf:nodeID="nfccfa9717b284cdcbbfedaf39b72b723b12">
                        <owl:onProperty rdf:resource="https://dgg32.github.io/glp/ontology#inTherapeuticClass"/>
                        <owl:hasValue rdf:resource="https://dgg32.github.io/glp/vocab/therapeutic-class/GLP1ReceptorAgonist"/>
                      </owl:Restriction>
                    </owl:someValuesFrom>
                  </owl:Restriction>
                </owl:someValuesFrom>
              </owl:Restriction>
            </owl:someValuesFrom>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://dgg32.github.io/glp/ontology#pseudonymousId">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">pseudonymous ID</rdfs:label>
    <rdfs:label xml:lang="ja">仮名ID</rdfs:label>
    <rdfs:label xml:lang="zh">假名化ID</rdfs:label>
    <rdfs:domain rdf:resource="https://dgg32.github.io/glp/ontology#HealthcareProfessional"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition xml:lang="en">First 16 hex characters of HMAC-SHA256(secret key, NPI). Stable across runs with the same key; not reversible without it.</skos:definition>
    <rdfs:comment xml:lang="en">The source data is public and names the prescribers, so a determined reader could still re-identify someone by matching claim counts. The pseudonym keeps names and NPIs out of the graph, demos and screenshots; it is not anonymization.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://dgg32.github.io/glp/ontology#totalClaims">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">total claims</rdfs:label>
    <rdfs:domain rdf:resource="https://dgg32.github.io/glp/ontology#Prescription"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
    <skos:definition xml:lang="en">Number of Part D claims, including refills (CMS Tot_Clms).</skos:definition>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://dgg32.github.io/glp/ontology#hasIndication">
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="https://spec.pistoiaalliance.org/idmp/ontology/ISO/ISO11615-MedicinalProducts/hasTherapeuticIndication">
        <rdfs:label xml:lang="en">has therapeutic indication</rdfs:label>
        <rdfs:isDefinedBy rdf:resource="https://spec.pistoiaalliance.org/idmp/ontology/ISO/ISO11615-MedicinalProducts/"/>
      </owl:ObjectProperty>
    </rdfs:subPropertyOf>
    <rdfs:label xml:lang="en">has indication</rdfs:label>
    <rdfs:domain rdf:resource="https://dgg32.github.io/glp/ontology#MedicinalProduct"/>
    <rdfs:range rdf:resource="https://dgg32.github.io/glp/ontology#Indication"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://dgg32.github.io/glp/ontology#SGLT2Prescriber">
    <rdfs:label xml:lang="en">SGLT2 inhibitor prescriber</rdfs:label>
    <rdfs:label xml:lang="ja">SGLT2阻害薬処方医</rdfs:label>
    <rdfs:label xml:lang="zh">SGLT2抑制剂处方者</rdfs:label>
    <skos:definition xml:lang="en">A healthcare professional who wrote at least one prescription for a product containing a substance in the SGLT2 inhibitor class.</skos:definition>
    <owl:equivalentClass>
      <owl:Class rdf:nodeID="nfccfa9717b284cdcbbfedaf39b72b723b1">
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://dgg32.github.io/glp/ontology#HealthcareProfessional"/>
          <owl:Restriction rdf:nodeID="nfccfa9717b284cdcbbfedaf39b72b723b2">
            <owl:onProperty rdf:resource="https://dgg32.github.io/glp/ontology#writes"/>
            <owl:someValuesFrom>
              <owl:Restriction rdf:nodeID="nfccfa9717b284cdcbbfedaf39b72b723b3">
                <owl:onProperty rdf:resource="https://dgg32.github.io/glp/ontology#forProduct"/>
                <owl:someValuesFrom>
                  <owl:Restriction rdf:nodeID="nfccfa9717b284cdcbbfedaf39b72b723b4">
                    <owl:onProperty rdf:resource="https://dgg32.github.io/glp/ontology#hasActiveSubstance"/>
                    <owl:someValuesFrom>
                      <owl:Restriction rdf:nodeID="nfccfa9717b284cdcbbfedaf39b72b723b5">
                        <owl:onProperty rdf:resource="https://dgg32.github.io/glp/ontology#inTherapeuticClass"/>
                        <owl:hasValue rdf:resource="https://dgg32.github.io/glp/vocab/therapeutic-class/SGLT2Inhibitor"/>
                      </owl:Restriction>
                    </owl:someValuesFrom>
                  </owl:Restriction>
                </owl:someValuesFrom>
              </owl:Restriction>
            </owl:someValuesFrom>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://dgg32.github.io/glp/ontology#dataYear">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">data year</rdfs:label>
    <rdfs:domain rdf:resource="https://dgg32.github.io/glp/ontology#Prescription"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#gYear"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://dgg32.github.io/glp/ontology#state">
    <rdfs:label xml:lang="en">state</rdfs:label>
    <rdfs:domain rdf:resource="https://dgg32.github.io/glp/ontology#HealthcareProfessional"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://dgg32.github.io/glp/ontology#total30DayFills">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">total 30-day fills</rdfs:label>
    <rdfs:domain rdf:resource="https://dgg32.github.io/glp/ontology#Prescription"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <skos:definition xml:lang="en">Claims standardized to 30-day fills; a 90-day fill counts as 3.0 (CMS Tot_30day_Fills).</skos:definition>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://dgg32.github.io/glp/ontology#isCombinationProduct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">is combination product</rdfs:label>
    <rdfs:domain rdf:resource="https://dgg32.github.io/glp/ontology#MedicinalProduct"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://dgg32.github.io/glp/ontology#manufacturedBy">
    <rdfs:label xml:lang="en">manufactured by</rdfs:label>
    <rdfs:domain rdf:resource="https://dgg32.github.io/glp/ontology#MedicinalProduct"/>
    <rdfs:range rdf:resource="https://dgg32.github.io/glp/ontology#Organization"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://dgg32.github.io/glp/ontology#beneficiaryCountSuppressed">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">beneficiary count suppressed</rdfs:label>
    <rdfs:domain rdf:resource="https://dgg32.github.io/glp/ontology#Prescription"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment xml:lang="en">Derived: CMS blanks Tot_Benes for 1-10 beneficiaries but publishes no flag for it.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://dgg32.github.io/glp/ontology#totalBeneficiaries">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">total beneficiaries</rdfs:label>
    <rdfs:domain rdf:resource="https://dgg32.github.io/glp/ontology#Prescription"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
    <skos:definition xml:lang="en">Number of distinct Medicare beneficiaries (CMS Tot_Benes). Absent when 1-10, to protect privacy.</skos:definition>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://dgg32.github.io/glp/ontology#city">
    <rdfs:label xml:lang="en">city</rdfs:label>
    <rdfs:domain rdf:resource="https://dgg32.github.io/glp/ontology#HealthcareProfessional"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://dgg32.github.io/glp/ontology#MedicinalProduct">
    <rdfs:subClassOf rdf:resource="https://spec.pistoiaalliance.org/idmp/ontology/ISO/ISO11615-MedicinalProducts/MedicinalProduct"/>
    <rdfs:label xml:lang="en">medicinal product</rdfs:label>
    <rdfs:label xml:lang="ja">医薬品</rdfs:label>
    <rdfs:label xml:lang="zh">药品</rdfs:label>
    <skos:definition xml:lang="en">A drug product as named in Part D claims (CMS Brnd_Name), e.g. Jardiance. Unbranded generics appear under their generic name.</skos:definition>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://dgg32.github.io/glp/ontology#inTherapeuticClass">
    <rdfs:label xml:lang="en">in therapeutic class</rdfs:label>
    <rdfs:domain rdf:resource="https://dgg32.github.io/glp/ontology#Substance"/>
    <rdfs:range rdf:resource="https://dgg32.github.io/glp/ontology#TherapeuticClass"/>
    <rdfs:comment xml:lang="en">Assert only the most specific class. The property chain rolls membership up the SKOS hierarchy, so empagliflozin in 'SGLT2 inhibitors' is also inferred to be in 'blood glucose lowering drugs'.</rdfs:comment>
    <owl:propertyChainAxiom rdf:parseType="Collection">
      <rdf:Description rdf:about="https://dgg32.github.io/glp/ontology#inTherapeuticClass"/>
      <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#broaderTransitive"/>
    </owl:propertyChainAxiom>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://dgg32.github.io/glp/ontology#TherapeuticClass">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">therapeutic class</rdfs:label>
    <rdfs:label xml:lang="ja">薬効分類</rdfs:label>
    <rdfs:label xml:lang="zh">治疗类别</rdfs:label>
    <skos:definition xml:lang="en">A concept in the therapeutic class scheme (e.g. SGLT2 inhibitors). The hierarchy itself is maintained as a SKOS concept scheme, not as OWL subclasses.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://dgg32.github.io/glp/ontology#HealthcareProfessional">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Person"/>
    <rdfs:label xml:lang="en">healthcare professional</rdfs:label>
    <rdfs:label xml:lang="ja">医療従事者</rdfs:label>
    <rdfs:label xml:lang="zh">医疗专业人员</rdfs:label>
    <skos:definition xml:lang="en">An individual (NPI type 1) who prescribes drugs reimbursed under Medicare Part D.</skos:definition>
    <rdfs:seeAlso rdf:resource="http://hl7.org/fhir/Practitioner"/>
    <rdfs:comment xml:lang="en">Not covered by IDMP-O, which models regulatory product identity rather than commercial data. HL7 FHIR Practitioner is the closest standard concept (seeAlso, not a logical alignment).</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://dgg32.github.io/glp/ontology#Prescription">
    <rdfs:label xml:lang="en">prescription aggregate</rdfs:label>
    <rdfs:label xml:lang="ja">処方集計</rdfs:label>
    <rdfs:label xml:lang="zh">处方汇总</rdfs:label>
    <skos:definition xml:lang="en">The total Part D claims, fills, days of supply, cost and beneficiaries of one healthcare professional for one medicinal product in one data year. One row of the CMS 'Prescribers by Provider and Drug' dataset.</skos:definition>
    <rdfs:comment xml:lang="en">Modelled as a node (not as an edge with properties, as in a property graph) because RDF statements cannot carry attributes without reification.</rdfs:comment>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://dgg32.github.io/glp/vocab/therapeutic-class/SGLT2Inhibitor">
    <rdf:type rdf:resource="https://dgg32.github.io/glp/ontology#TherapeuticClass"/>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://dgg32.github.io/glp/ontology#Organization">
    <rdfs:subClassOf rdf:resource="https://www.omg.org/spec/Commons/Organizations/Organization"/>
    <rdfs:label xml:lang="en">organization</rdfs:label>
    <rdfs:label xml:lang="ja">組織</rdfs:label>
    <rdfs:label xml:lang="zh">组织</rdfs:label>
    <skos:definition xml:lang="en">A company that holds the US marketing application for a medicinal product, taken as its corporate group, e.g. Boehringer Ingelheim.</skos:definition>
    <rdfs:comment xml:lang="en">Drugs@FDA application holders are grouped by their GLEIF ultimate parent; the LEI of that parent is the dcterms:identifier and the last segment of the IRI.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://spec.pistoiaalliance.org/idmp/ontology/ISO/ISO11238-Substances/Substance">
    <rdfs:label xml:lang="en">substance</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://spec.pistoiaalliance.org/idmp/ontology/ISO/ISO11238-Substances/"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://dgg32.github.io/glp/ontology#hasActiveSubstance">
    <rdfs:label xml:lang="en">has active substance</rdfs:label>
    <rdfs:domain rdf:resource="https://dgg32.github.io/glp/ontology#MedicinalProduct"/>
    <rdfs:range rdf:resource="https://dgg32.github.io/glp/ontology#Substance"/>
    <rdfs:comment xml:lang="en">Shortcut for the IDMP-O pattern product -hasActiveIngredient-&gt; ActiveIngredient role -isPlayedBy-&gt; Substance. The property chain makes data modelled the IDMP-O way also answer queries that use this shortcut.</rdfs:comment>
    <owl:propertyChainAxiom rdf:parseType="Collection">
      <rdf:Description rdf:about="https://spec.pistoiaalliance.org/idmp/ontology/ISO/ISO11615-MedicinalProducts/hasActiveIngredient"/>
      <rdf:Description rdf:about="https://www.omg.org/spec/Commons/RolesAndCompositions/isPlayedBy"/>
    </owl:propertyChainAxiom>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://www.w3.org/ns/prov#Person">
    <rdfs:label xml:lang="en">person</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/prov#"/>
  </owl:Class>
  <owl:Class rdf:about="https://dgg32.github.io/glp/ontology#Indication">
    <rdfs:subClassOf rdf:resource="https://spec.pistoiaalliance.org/idmp/ontology/ISO/ISO11615-MedicinalProducts/TherapeuticIndication"/>
    <rdfs:label xml:lang="en">indication</rdfs:label>
    <rdfs:label xml:lang="ja">適応症</rdfs:label>
    <rdfs:label xml:lang="zh">适应症</rdfs:label>
    <skos:definition xml:lang="en">A disease or condition a medicinal product is authorized to treat, as stated in its FDA label, e.g. type 2 diabetes mellitus or obesity.</skos:definition>
    <rdfs:comment xml:lang="en">Indication concepts are MeSH descriptors (skos:exactMatch to MeSH) in the SKOS indication scheme.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://spec.pistoiaalliance.org/idmp/ontology/ISO/ISO11615-MedicinalProducts/MedicinalProduct">
    <rdfs:label xml:lang="en">medicinal product</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://spec.pistoiaalliance.org/idmp/ontology/ISO/ISO11615-MedicinalProducts/"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://spec.pistoiaalliance.org/idmp/ontology/ISO/ISO11615-MedicinalProducts/hasActiveIngredient">
    <rdfs:label xml:lang="en">has active ingredient</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://spec.pistoiaalliance.org/idmp/ontology/ISO/ISO11615-MedicinalProducts/"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://dgg32.github.io/glp/ontology#forProduct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">for product</rdfs:label>
    <rdfs:domain rdf:resource="https://dgg32.github.io/glp/ontology#Prescription"/>
    <rdfs:range rdf:resource="https://dgg32.github.io/glp/ontology#MedicinalProduct"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://dgg32.github.io/glp/vocab/therapeutic-class/GLP1ReceptorAgonist">
    <rdf:type rdf:resource="https://dgg32.github.io/glp/ontology#TherapeuticClass"/>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://dgg32.github.io/glp/ontology#Specialty">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">specialty</rdfs:label>
    <rdfs:label xml:lang="ja">専門分野</rdfs:label>
    <rdfs:label xml:lang="zh">专科</rdfs:label>
    <skos:definition xml:lang="en">A concept from the NUCC Health Care Provider Taxonomy, published as a SKOS concept scheme.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://dgg32.github.io/glp/ontology#Substance">
    <rdfs:subClassOf rdf:resource="https://spec.pistoiaalliance.org/idmp/ontology/ISO/ISO11238-Substances/Substance"/>
    <rdfs:label xml:lang="en">substance</rdfs:label>
    <rdfs:label xml:lang="ja">有効成分</rdfs:label>
    <rdfs:label xml:lang="zh">活性成分</rdfs:label>
    <skos:definition xml:lang="en">An active substance of a medicinal product, e.g. empagliflozin. A combination product has more than one.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="http://www.w3.org/2004/02/skos/core#Concept">
    <rdfs:label xml:lang="en">concept</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2004/02/skos/core"/>
  </owl:Class>
  <owl:Class rdf:about="https://spec.pistoiaalliance.org/idmp/ontology/ISO/ISO11615-MedicinalProducts/TherapeuticIndication">
    <rdfs:label xml:lang="en">therapeutic indication</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://spec.pistoiaalliance.org/idmp/ontology/ISO/ISO11615-MedicinalProducts/"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://dgg32.github.io/glp/ontology#prescribedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">prescribed by</rdfs:label>
    <rdfs:domain rdf:resource="https://dgg32.github.io/glp/ontology#Prescription"/>
    <rdfs:range rdf:resource="https://dgg32.github.io/glp/ontology#HealthcareProfessional"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://www.omg.org/spec/Commons/RolesAndCompositions/isPlayedBy">
    <rdfs:label xml:lang="en">is played by</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.omg.org/spec/Commons/RolesAndCompositions/"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://www.omg.org/spec/Commons/Organizations/Organization">
    <rdfs:label xml:lang="en">organization</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://www.omg.org/spec/Commons/Organizations/"/>
  </owl:Class>
</rdf:RDF>
