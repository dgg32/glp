    dcterms:rights "Copyright notice: This is the official public release of the ontology. © Pistoia Alliance. Licensed under the MIT" ;
    dcterms:title "IDMP-O 1.4.0 extract (terms used by the Diabetes Drug Market Ontology)"@en ;
    prov:wasDerivedFrom <https://spec.pistoiaalliance.org/idmp/ontology/20260301/IdentificationOfMedicinalProductsOntology/> .

idmp-sub:Substance a owl:Class ;
    rdfs:isDefinedBy <https://spec.pistoiaalliance.org/idmp/ontology/IdentificationOfMedicinalProductsOntology/> ;
    rdfs:subClassOf idmp-mprd:ProductSpecification,
        <https://www.omg.org/spec/Commons/Documents/Specification> ;
    skos:definition "specification for matter of defined composition that has discrete existence, whose origin may be biological, mineral or chemical" .

idmp-mprd:MedicinalProduct a owl:Class ;
    rdfs:isDefinedBy <https://spec.pistoiaalliance.org/idmp/ontology/IdentificationOfMedicinalProductsOntology/> ;
    rdfs:subClassOf idmp-mprd:ProductSpecification ;
    skos:definition "specification for a pharmaceutical product or combination of pharmaceutical products that may be administered to human beings (or animals) for treating or preventing disease, with the aim/purpose of making a medical diagnosis or to restore, correct or modify physiological functions" .

idmp-mprd:TherapeuticIndication a owl:Class ;
    rdfs:isDefinedBy <https://spec.pistoiaalliance.org/idmp/ontology/IdentificationOfMedicinalProductsOntology/> ;
    rdfs:subClassOf <https://www.omg.org/spec/Commons/Documents/Specification> ;
    skos:definition "specification that defines the target disease or condition for which the medicinal product is authorized or under investigation" .

idmp-mprd:hasActiveIngredient a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://spec.pistoiaalliance.org/idmp/ontology/IdentificationOfMedicinalProductsOntology/> ;
    rdfs:subPropertyOf idmp-sub:hasIngredient ;
    skos:definition "relates something representing the constituents of a pharmaceutical or medicinal product to something in the role of an active ingredient" .

idmp-mprd:hasTherapeuticIndication a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://spec.pistoiaalliance.org/idmp/ontology/IdentificationOfMedicinalProductsOntology/> ;
    rdfs:subPropertyOf <https://www.omg.org/spec/Commons/Documents/isSpecifiedIn> ;
    skos:definition "relates a pharmaceutical product to a therapeutic indication that type of medical conditions where the treatment with the medicinal product is adviced" .

