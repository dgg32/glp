@prefix dm:         <https://dgg32.github.io/glp/ontology#> .
@prefix dmtc:       <https://dgg32.github.io/glp/vocab/therapeutic-class/> .
@prefix idmp-mprd:  <https://spec.pistoiaalliance.org/idmp/ontology/ISO/ISO11615-MedicinalProducts/> .
@prefix idmp-sub:   <https://spec.pistoiaalliance.org/idmp/ontology/ISO/ISO11238-Substances/> .
@prefix cmns-org:   <https://www.omg.org/spec/Commons/Organizations/> .
@prefix cmns-rlcmp: <https://www.omg.org/spec/Commons/RolesAndCompositions/> .
@prefix dcterms:    <http://purl.org/dc/terms/> .
@prefix owl:        <http://www.w3.org/2002/07/owl#> .
@prefix prov:       <http://www.w3.org/ns/prov#> .
@prefix qb:         <http://purl.org/linked-data/cube#> .
@prefix sdmx-attribute: <http://purl.org/linked-data/sdmx/2009/attribute#> .
@prefix sdmx-code:  <http://purl.org/linked-data/sdmx/2009/code#> .
@prefix rdf:        <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:       <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:        <http://www.w3.org/2001/XMLSchema#> .

#################################################################
#  Ontology header
#################################################################

<https://dgg32.github.io/glp/ontology> a owl:Ontology ;
    dcterms:title "Diabetes Drug Market Ontology"@en , "糖尿病治療薬市場オントロジー"@ja , "糖尿病药物市场本体"@zh ;
    dcterms:description "A small OWL ontology for the type 2 diabetes drug market in two claims datasets: US Medicare Part D prescribing (who prescribes which product) and Japan's NDB Open Data (how much of each product is dispensed, by prefecture, month and sex-age band). Product and substance classes are aligned to IDMP-O 1.4.0; NDB tables are modelled with the W3C RDF Data Cube vocabulary; commercial concepts (prescriber, prescription aggregate) are not covered by IDMP-O and are defined here."@en ;
    dcterms:creator "Sixing Huang" ;
    dcterms:created "2026-10-14"^^xsd:date ;
    dcterms:license <https://opensource.org/licenses/MIT> ;
    owl:versionIRI <https://dgg32.github.io/glp/ontology/0.5.0> ;
    owl:versionInfo "0.5.0" ;
    owl:priorVersion <https://dgg32.github.io/glp/ontology/0.4.0> ;
    skos:changeNote "0.5.0 (2026-10-25): Japan (NDB Open Data). Added dm:QuantitySlice (an RDF Data Cube slice) with dm:aboutProduct, dm:careSetting and dm:totalQuantity, the observation dimensions dm:prefecture, dm:month and dm:sexAgeGroup, the measure dm:quantity and the SDMX confidentiality attribute for masked cells; Japanese product attributes (dm:yjCode, dm:receiptCode, dm:nhiPrice, dm:dispensingUnit, dm:isGeneric, dm:isOriginator, dm:routeOfAdministration, dm:inJapaneseDrugClass); dm:partOfCorporateGroup; concept classes dm:Prefecture, dm:SexAgeGroup, dm:CareSetting, dm:JapaneseDrugClass; defined classes dm:SGLT2Product and dm:GLP1Product. dm:MedicinalProduct and dm:Organization now cover Japanese products and marketing authorization holders. No change to existing axioms."@en ;
    skos:changeNote "0.4.0 (2026-10-15): definitions only, no axiom changes. dm:Indication: indications are MeSH descriptors stated in FDA labels (example 'obesity' replaces 'chronic weight management'). dm:Organization: a company is the corporate group of a Drugs@FDA application holder, identified by the LEI of its GLEIF ultimate parent."@en ;
    skos:changeNote "0.3.0 (2026-10-14): added dm:pseudonymousId (prescribers are identified by a keyed hash, never by NPI or name, in loaded data) and dm:cmsGenericName."@en ;
    skos:changeNote "0.2.0 (2026-10-14): removed the age 65+ datatype properties to stay well inside the Stardog Cloud Free 1M-edge limit; dm:writes is now inferred only; IDMP-O definitions moved to imports/idmp-o-1.4.0-extract.ttl."@en ;
    rdfs:comment "IDMP-O and OMG Commons terms are referenced, not imported. The few external terms used are declared below (label + isDefinedBy only), following the MIREOT approach that IDMP-O itself adopted in release 1.8.0. Load the full IDMP-O into its own named graph if its axioms are needed."@en .

#################################################################
#  Classes
#################################################################

dm:HealthcareProfessional a owl:Class ;
    rdfs:subClassOf prov:Person ;
    rdfs:label "healthcare professional"@en , "医療従事者"@ja , "医疗专业人员"@zh ;
    skos:definition "An individual (NPI type 1) who prescribes drugs reimbursed under Medicare Part D."@en ;
    rdfs:seeAlso <http://hl7.org/fhir/Practitioner> ;
    rdfs:comment "Not covered by IDMP-O, which models regulatory product identity rather than commercial data. HL7 FHIR Practitioner is the closest standard concept (seeAlso, not a logical alignment)."@en .

dm:Prescription a owl:Class ;
    rdfs:label "prescription aggregate"@en , "処方集計"@ja , "处方汇总"@zh ;
    skos:definition "The total Part D claims, fills, days of supply, cost and beneficiaries of one healthcare professional for one medicinal product in one data year. One row of the CMS 'Prescribers by Provider and Drug' dataset."@en ;
    rdfs:comment "Modelled as a node (not as an edge with properties, as in a property graph) because RDF statements cannot carry attributes without reification."@en .

dm:MedicinalProduct a owl:Class ;
    rdfs:subClassOf idmp-mprd:MedicinalProduct ;
    rdfs:label "medicinal product"@en , "医薬品"@ja , "药品"@zh ;
    skos:definition "A drug product as named in claims data: in Part D (CMS Brnd_Name, e.g. Jardiance; unbranded generics appear under their generic name), or in NDB Open Data, where each strength is its own product with a receipt code and a YJ code (e.g. ジャディアンス錠10mg)."@en ;
    rdfs:comment "US products are brand-level (all strengths together), Japanese products strength-level, because that is how each source counts. Compare them through their substances and classes, not one to one."@en .

dm:Substance a owl:Class ;
    rdfs:subClassOf idmp-sub:Substance ;
    rdfs:label "substance"@en , "有効成分"@ja , "活性成分"@zh ;
    skos:definition "An active substance of a medicinal product, e.g. empagliflozin. A combination product has more than one."@en .

dm:TherapeuticClass a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "therapeutic class"@en , "薬効分類"@ja , "治疗类别"@zh ;
    skos:definition "A concept in the therapeutic class scheme (e.g. SGLT2 inhibitors). The hierarchy itself is maintained as a SKOS concept scheme, not as OWL subclasses."@en .

dm:Specialty a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "specialty"@en , "専門分野"@ja , "专科"@zh ;
    skos:definition "A concept from the NUCC Health Care Provider Taxonomy, published as a SKOS concept scheme."@en .

dm:Indication a owl:Class ;
    rdfs:subClassOf idmp-mprd:TherapeuticIndication ;
    rdfs:label "indication"@en , "適応症"@ja , "适应症"@zh ;
    skos:definition "A disease or condition a medicinal product is authorized to treat, as stated in its FDA label, e.g. type 2 diabetes mellitus or obesity."@en ;
    rdfs:comment "Indication concepts are MeSH descriptors (skos:exactMatch to MeSH) in the SKOS indication scheme."@en .

dm:Organization a owl:Class ;
    rdfs:subClassOf cmns-org:Organization ;
    rdfs:label "organization"@en , "組織"@ja , "组织"@zh ;
    skos:definition "A company that holds the marketing authorization for a medicinal product: in the US the corporate group of the Drugs@FDA application holder (e.g. Boehringer Ingelheim), in Japan the holder named in the NHI price list (e.g. 日本ベーリンガーインゲルハイム)."@en ;
    rdfs:comment "Drugs@FDA application holders are grouped by their GLEIF ultimate parent; the LEI of that parent is the dcterms:identifier and the last segment of the IRI. A Japanese subsidiary of such a group links to it with dm:partOfCorporateGroup."@en .

dm:QuantitySlice a owl:Class ;
    rdfs:subClassOf qb:Slice ;
    rdfs:label "quantity slice"@en , "数量スライス"@ja , "数量切片"@zh ;
    skos:definition "The quantity of one medicinal product dispensed in one care setting in one NDB Open Data release, broken down by one dimension (prefecture, month or sex-age band). One row of one NDB table; its cells are the qb:observation values."@en ;
    rdfs:comment "An RDF Data Cube slice fixes product, care setting and dimension once, so each cell needs only three triples: the link from the slice, the dimension value, and the quantity or the confidentiality flag."@en .

dm:Prefecture a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "prefecture"@en , "都道府県"@ja , "都道府县"@zh ;
    skos:definition "One of Japan's 47 prefectures, identified by its JIS X 0401 code (01-47)."@en .

dm:SexAgeGroup a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "sex and age band"@en , "性・年齢階級"@ja , "性别年龄组"@zh ;
    skos:definition "A sex combined with a five-year age band (0-4 ... 95-99, 100+), as NDB Open Data reports them."@en .

dm:CareSetting a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "care setting"@en , "診療区分"@ja , "诊疗类别"@zh ;
    skos:definition "Where a drug was prescribed and dispensed: outpatient with a prescription filled at a community pharmacy (院外), outpatient dispensed in the clinic or hospital (院内), or inpatient (入院)."@en .

dm:JapaneseDrugClass a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Japanese therapeutic category"@en , "薬効分類"@ja , "日本药效分类"@zh ;
    skos:definition "A three-digit therapeutic category of the Japan Standard Commodity Classification (薬効分類), as used by the NHI price list and NDB Open Data, e.g. 396 糖尿病用剤."@en ;
    rdfs:comment "Not the same tree as ATC: GLP-1 receptor agonists are filed under 249 (other hormone preparations). The SKOS mapping properties in vocab/jp-drug-class.ttl relate the two."@en .

# --- Defined classes: membership is inferred by the reasoner, never asserted ---

dm:SGLT2Prescriber a owl:Class ;
    rdfs:label "SGLT2 inhibitor prescriber"@en , "SGLT2阻害薬処方医"@ja , "SGLT2抑制剂处方者"@zh ;
    skos:definition "A healthcare professional who wrote at least one prescription for a product containing a substance in the SGLT2 inhibitor class."@en ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            dm:HealthcareProfessional
            [ a owl:Restriction ;
              owl:onProperty dm:writes ;
              owl:someValuesFrom [ a owl:Restriction ;
                  owl:onProperty dm:forProduct ;
                  owl:someValuesFrom [ a owl:Restriction ;
                      owl:onProperty dm:hasActiveSubstance ;
                      owl:someValuesFrom [ a owl:Restriction ;
                          owl:onProperty dm:inTherapeuticClass ;
                          owl:hasValue dmtc:SGLT2Inhibitor ] ] ] ]
        )
    ] .

dm:GLP1Prescriber a owl:Class ;
    rdfs:label "GLP-1 receptor agonist prescriber"@en , "GLP-1受容体作動薬処方医"@ja , "GLP-1受体激动剂处方者"@zh ;
    skos:definition "A healthcare professional who wrote at least one prescription for a product containing a substance in the GLP-1 receptor agonist class (including narrower classes such as dual GIP/GLP-1 agonists)."@en ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            dm:HealthcareProfessional
            [ a owl:Restriction ;
              owl:onProperty dm:writes ;
              owl:someValuesFrom [ a owl:Restriction ;
                  owl:onProperty dm:forProduct ;
                  owl:someValuesFrom [ a owl:Restriction ;
                      owl:onProperty dm:hasActiveSubstance ;
                      owl:someValuesFrom [ a owl:Restriction ;
                          owl:onProperty dm:inTherapeuticClass ;
                          owl:hasValue dmtc:GLP1ReceptorAgonist ] ] ] ]
        )
    ] .

dm:SGLT2Product a owl:Class ;
    rdfs:label "SGLT2 inhibitor product"@en , "SGLT2阻害薬製剤"@ja , "SGLT2抑制剂产品"@zh ;
    skos:definition "A medicinal product containing a substance in the SGLT2 inhibitor class, alone or in combination."@en ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            dm:MedicinalProduct
            [ a owl:Restriction ;
              owl:onProperty dm:hasActiveSubstance ;
              owl:someValuesFrom [ a owl:Restriction ;
                  owl:onProperty dm:inTherapeuticClass ;
                  owl:hasValue dmtc:SGLT2Inhibitor ] ]
        )
    ] .

dm:GLP1Product a owl:Class ;
    rdfs:label "GLP-1 receptor agonist product"@en , "GLP-1受容体作動薬製剤"@ja , "GLP-1受体激动剂产品"@zh ;
    skos:definition "A medicinal product containing a substance in the GLP-1 receptor agonist class (including dual GIP/GLP-1 agonists), alone or in combination, whatever its Japanese therapeutic category (249 or 396)."@en ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            dm:MedicinalProduct
            [ a owl:Restriction ;
              owl:onProperty dm:hasActiveSubstance ;
              owl:someValuesFrom [ a owl:Restriction ;
                  owl:onProperty dm:inTherapeuticClass ;
                  owl:hasValue dmtc:GLP1ReceptorAgonist ] ]
        )
    ] .

#################################################################
#  Object properties (relationships)
#################################################################

dm:writes a owl:ObjectProperty ;
    rdfs:label "writes"@en ;
    rdfs:comment "Not stored in the data: only dm:prescribedBy is asserted and dm:writes is inferred through owl:inverseOf (saves one triple per prescription). Queries without reasoning must use ^dm:prescribedBy."@en ;
    rdfs:domain dm:HealthcareProfessional ;
    rdfs:range dm:Prescription ;
    owl:inverseOf dm:prescribedBy .

dm:prescribedBy a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "prescribed by"@en ;
    rdfs:domain dm:Prescription ;
    rdfs:range dm:HealthcareProfessional .

dm:forProduct a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "for product"@en ;
    rdfs:domain dm:Prescription ;
    rdfs:range dm:MedicinalProduct .

dm:hasActiveSubstance a owl:ObjectProperty ;
    rdfs:label "has active substance"@en ;
    rdfs:domain dm:MedicinalProduct ;
    rdfs:range dm:Substance ;
    rdfs:comment "Shortcut for the IDMP-O pattern product -hasActiveIngredient-> ActiveIngredient role -isPlayedBy-> Substance. The property chain makes data modelled the IDMP-O way also answer queries that use this shortcut."@en .

# IDMP-O alignment: the active-ingredient role chain implies the shortcut.
dm:hasActiveSubstance owl:propertyChainAxiom ( idmp-mprd:hasActiveIngredient cmns-rlcmp:isPlayedBy ) .

dm:inTherapeuticClass a owl:ObjectProperty ;
    rdfs:label "in therapeutic class"@en ;
    rdfs:domain dm:Substance ;
    rdfs:range dm:TherapeuticClass ;
    rdfs:comment "Assert only the most specific class. The property chain rolls membership up the SKOS hierarchy, so empagliflozin in 'SGLT2 inhibitors' is also inferred to be in 'blood glucose lowering drugs'."@en ;
    owl:propertyChainAxiom ( dm:inTherapeuticClass skos:broaderTransitive ) .

dm:hasSpecialty a owl:ObjectProperty ;
    rdfs:label "has specialty"@en ;
    rdfs:domain dm:HealthcareProfessional ;
    rdfs:range dm:Specialty .

dm:hasPrimarySpecialty a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:subPropertyOf dm:hasSpecialty ;
    rdfs:label "has primary specialty"@en ;
    rdfs:comment "The NPI Registry taxonomy flagged primary."@en .

dm:hasIndication a owl:ObjectProperty ;
    rdfs:subPropertyOf idmp-mprd:hasTherapeuticIndication ;
    rdfs:label "has indication"@en ;
    rdfs:domain dm:MedicinalProduct ;
    rdfs:range dm:Indication .

dm:manufacturedBy a owl:ObjectProperty ;
    rdfs:label "manufactured by"@en ;
    rdfs:domain dm:MedicinalProduct ;
    rdfs:range dm:Organization .

dm:partOfCorporateGroup a owl:ObjectProperty ;
    rdfs:label "part of corporate group"@en ;
    rdfs:domain dm:Organization ;
    rdfs:range dm:Organization ;
    skos:definition "Links a national company (e.g. the Japanese marketing authorization holder 日本ベーリンガーインゲルハイム) to its corporate group as identified by GLEIF."@en .

dm:inJapaneseDrugClass a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "in Japanese therapeutic category"@en ;
    rdfs:domain dm:MedicinalProduct ;
    rdfs:range dm:JapaneseDrugClass .

# --- NDB Open Data (RDF Data Cube) ---
dm:aboutProduct a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "about product"@en ;
    rdfs:domain dm:QuantitySlice ;
    rdfs:range dm:MedicinalProduct ;
    rdfs:comment "Not dm:forProduct, whose domain is dm:Prescription: with reasoning, every slice would become a prescription."@en .

dm:careSetting a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "care setting"@en ;
    rdfs:domain dm:QuantitySlice ;
    rdfs:range dm:CareSetting .

dm:prefecture a owl:ObjectProperty , qb:DimensionProperty ;
    rdfs:label "prefecture"@en ;
    rdfs:range dm:Prefecture ;
    skos:definition "The prefecture of the medical institution that issued the claim (not where the patient lives)."@en .

dm:sexAgeGroup a owl:ObjectProperty , qb:DimensionProperty ;
    rdfs:label "sex and age band"@en ;
    rdfs:range dm:SexAgeGroup .

#################################################################
#  Datatype properties (attributes)
#################################################################

# --- HealthcareProfessional ---
dm:npi a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "NPI"@en ;
    rdfs:domain dm:HealthcareProfessional ;
    rdfs:range xsd:string ;
    skos:definition "US National Provider Identifier (10 digits)."@en ;
    rdfs:comment "Privacy by design: never written to the generated RDF. Prescribers are identified by dm:pseudonymousId instead."@en .

dm:pseudonymousId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "pseudonymous ID"@en , "仮名ID"@ja , "假名化ID"@zh ;
    rdfs:domain dm:HealthcareProfessional ;
    rdfs:range xsd:string ;
    skos:definition "First 16 hex characters of HMAC-SHA256(secret key, NPI). Stable across runs with the same key; not reversible without it."@en ;
    rdfs:comment "The source data is public and names the prescribers, so a determined reader could still re-identify someone by matching claim counts. The pseudonym keeps names and NPIs out of the graph, demos and screenshots; it is not anonymization."@en .

dm:cmsPrescriberType a owl:DatatypeProperty ;
    rdfs:label "CMS prescriber type"@en ;
    rdfs:domain dm:HealthcareProfessional ;
    rdfs:range xsd:string ;
    skos:definition "Specialty as reported by CMS (Prscrbr_Type), a free-text label that differs from the NUCC code."@en .

dm:city a owl:DatatypeProperty ;
    rdfs:label "city"@en ;
    rdfs:domain dm:HealthcareProfessional ;
    rdfs:range xsd:string .

dm:state a owl:DatatypeProperty ;
    rdfs:label "state"@en ;
    rdfs:domain dm:HealthcareProfessional ;
    rdfs:range xsd:string .

# --- Prescription aggregate: all-ages figures ---
dm:dataYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "data year"@en ;
    rdfs:domain dm:Prescription ;
    rdfs:range xsd:gYear .

dm:totalClaims a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total claims"@en ;
    rdfs:domain dm:Prescription ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "Number of Part D claims, including refills (CMS Tot_Clms)."@en .

dm:total30DayFills a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total 30-day fills"@en ;
    rdfs:domain dm:Prescription ;
    rdfs:range xsd:decimal ;
    skos:definition "Claims standardized to 30-day fills; a 90-day fill counts as 3.0 (CMS Tot_30day_Fills)."@en .

dm:totalDaySupply a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total day supply"@en ;
    rdfs:domain dm:Prescription ;
    rdfs:range xsd:nonNegativeInteger .

dm:totalDrugCost a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total drug cost (USD)"@en ;
    rdfs:domain dm:Prescription ;
    rdfs:range xsd:decimal ;
    skos:definition "Aggregate gross drug cost paid by Part D plan, beneficiary and other payers, in US dollars (CMS Tot_Drug_Cst)."@en .

dm:totalBeneficiaries a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total beneficiaries"@en ;
    rdfs:domain dm:Prescription ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "Number of distinct Medicare beneficiaries (CMS Tot_Benes). Absent when 1-10, to protect privacy."@en .

dm:beneficiaryCountSuppressed a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "beneficiary count suppressed"@en ;
    rdfs:domain dm:Prescription ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Derived: CMS blanks Tot_Benes for 1-10 beneficiaries but publishes no flag for it."@en .

# --- MedicinalProduct ---
dm:cmsGenericName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "CMS generic name"@en ;
    rdfs:domain dm:MedicinalProduct ;
    rdfs:range xsd:string ;
    skos:definition "Generic name exactly as spelled in the CMS data (Gnrc_Name), e.g. 'Dapaglifloz Propaned/Metformin'."@en .

dm:isCombinationProduct a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is combination product"@en ;
    rdfs:domain dm:MedicinalProduct ;
    rdfs:range xsd:boolean .

# --- MedicinalProduct (Japan) ---
dm:yjCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "YJ code"@en , "薬価基準収載医薬品コード"@ja ;
    rdfs:domain dm:MedicinalProduct ;
    rdfs:range xsd:string ;
    skos:definition "The 12-character NHI price list code (薬価基準収載医薬品コード). Characters 1-4 are the therapeutic category, 1-7 the ingredient, 8 the dosage form."@en .

dm:receiptCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "receipt code"@en , "レセプト電算処理システム用コード"@ja ;
    rdfs:domain dm:MedicinalProduct ;
    rdfs:range xsd:string ;
    skos:definition "The 9-digit drug code of the claims (receipt) processing system (医薬品コード), the key of NDB Open Data."@en .

dm:nhiPrice a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "NHI price (JPY per unit)"@en , "薬価"@ja ;
    rdfs:domain dm:MedicinalProduct ;
    rdfs:range xsd:decimal ;
    skos:definition "Reimbursement price in yen per dispensing unit (tablet, pen, ...), as printed in NDB Open Data."@en ;
    rdfs:comment "MHLW updated the prices in the 11th release to the price list of 2026-09-02, so quantity x price is the FY2024 volume at current prices, not FY2024 spending."@en .

dm:dispensingUnit a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dispensing unit"@en , "単位"@ja ;
    rdfs:domain dm:MedicinalProduct ;
    rdfs:range xsd:string ;
    skos:definition "The unit in which quantities are counted (錠 tablet, キット kit, 筒 cartridge ...). Quantities in different units cannot be added."@en .

dm:isGeneric a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is generic"@en , "後発品"@ja ;
    rdfs:domain dm:MedicinalProduct ;
    rdfs:range xsd:boolean ;
    skos:definition "Generic (後発医薬品) according to NDB Open Data's 後発品区分; biosimilars count as generics."@en ;
    rdfs:comment "The reimbursement definition, not the pharmaceutical one: generics priced at the originator's level (marked ★ in the NHI price list) are not flagged. Most metformin generics (the 'MT' products, priced like Metgluco) are such a case, so metformin's generic share looks near zero."@en .

dm:isOriginator a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "is originator"@en , "先発品"@ja ;
    rdfs:domain dm:MedicinalProduct ;
    rdfs:range xsd:boolean ;
    skos:definition "Flagged 先発品 (originator) in the NHI price list. Neither generic nor originator: older products that predate the distinction and unified-name listings."@en .

dm:routeOfAdministration a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "route of administration"@en , "投与経路"@ja ;
    rdfs:domain dm:MedicinalProduct ;
    rdfs:range xsd:string ;
    skos:definition "\"oral\" or \"injection\": the NDB table family (内服 / 注射) the product is reported in. Masking thresholds differ: 1,000 for oral, 400 for injection tables."@en .

# --- QuantitySlice and its observations ---
dm:totalQuantity a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "total quantity"@en , "総計（処方数量）"@ja ;
    rdfs:domain dm:QuantitySlice ;
    rdfs:range xsd:decimal ;
    skos:definition "The national total of the row (総計). Unmasked unless the whole product is below the masking threshold in that care setting; then the slice carries sdmx-attribute:confStatus instead."@en .

dm:month a owl:DatatypeProperty , qb:DimensionProperty ;
    rdfs:label "month of care"@en , "診療月"@ja ;
    rdfs:range xsd:gYearMonth .

dm:quantity a owl:DatatypeProperty , qb:MeasureProperty ;
    rdfs:label "quantity"@en , "処方数量"@ja ;
    rdfs:range xsd:decimal ;
    skos:definition "Dispensed quantity in the product's dispensing unit. Absent when NDB masked the cell; the observation then carries sdmx-attribute:confStatus sdmx-code:confStatus-C."@en .

dm:minAge a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "minimum age"@en ;
    rdfs:domain dm:SexAgeGroup ;
    rdfs:range xsd:integer ;
    skos:definition "Lower bound of the age band in years (65 for 65-69)."@en .

#################################################################
#  External terms (MIREOT-style declarations, not imports)
#################################################################

idmp-mprd:MedicinalProduct a owl:Class ;
    rdfs:label "medicinal product"@en ;
    rdfs:isDefinedBy <https://spec.pistoiaalliance.org/idmp/ontology/ISO/ISO11615-MedicinalProducts/> .

idmp-mprd:TherapeuticIndication a owl:Class ;
    rdfs:label "therapeutic indication"@en ;
    rdfs:isDefinedBy <https://spec.pistoiaalliance.org/idmp/ontology/ISO/ISO11615-MedicinalProducts/> .

idmp-mprd:hasActiveIngredient a owl:ObjectProperty ;
    rdfs:label "has active ingredient"@en ;
    rdfs:isDefinedBy <https://spec.pistoiaalliance.org/idmp/ontology/ISO/ISO11615-MedicinalProducts/> .

idmp-mprd:hasTherapeuticIndication a owl:ObjectProperty ;
    rdfs:label "has therapeutic indication"@en ;
    rdfs:isDefinedBy <https://spec.pistoiaalliance.org/idmp/ontology/ISO/ISO11615-MedicinalProducts/> .

idmp-sub:Substance a owl:Class ;
    rdfs:label "substance"@en ;
    rdfs:isDefinedBy <https://spec.pistoiaalliance.org/idmp/ontology/ISO/ISO11238-Substances/> .

cmns-org:Organization a owl:Class ;
    rdfs:label "organization"@en ;
    rdfs:isDefinedBy <https://www.omg.org/spec/Commons/Organizations/> .

cmns-rlcmp:isPlayedBy a owl:ObjectProperty ;
    rdfs:label "is played by"@en ;
    rdfs:isDefinedBy <https://www.omg.org/spec/Commons/RolesAndCompositions/> .

prov:Person a owl:Class ;
    rdfs:label "person"@en ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov#> .

skos:Concept a owl:Class ;
    rdfs:label "concept"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> .

skos:broaderTransitive a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:label "has broader transitive"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> .

skos:broader a owl:ObjectProperty ;
    rdfs:subPropertyOf skos:broaderTransitive ;
    rdfs:label "has broader"@en ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> .

qb:DataSet a owl:Class ;
    rdfs:label "data set"@en ;
    rdfs:isDefinedBy <http://purl.org/linked-data/cube> .

qb:Slice a owl:Class ;
    rdfs:label "slice"@en ;
    rdfs:isDefinedBy <http://purl.org/linked-data/cube> .

qb:SliceKey a owl:Class ;
    rdfs:label "slice key"@en ;
    rdfs:isDefinedBy <http://purl.org/linked-data/cube> .

qb:Observation a owl:Class ;
    rdfs:label "observation"@en ;
    rdfs:isDefinedBy <http://purl.org/linked-data/cube> .

qb:DimensionProperty a owl:Class ;
    rdfs:label "dimension property"@en ;
    rdfs:isDefinedBy <http://purl.org/linked-data/cube> .

qb:MeasureProperty a owl:Class ;
    rdfs:label "measure property"@en ;
    rdfs:isDefinedBy <http://purl.org/linked-data/cube> .

qb:observation a owl:ObjectProperty ;
    rdfs:label "observation"@en ;
    rdfs:domain qb:Slice ;
    rdfs:range qb:Observation ;
    rdfs:comment "Observations are not typed in the data (one triple each saved); the range types them under reasoning."@en ;
    rdfs:isDefinedBy <http://purl.org/linked-data/cube> .

qb:slice a owl:ObjectProperty ;
    rdfs:label "slice"@en ;
    rdfs:domain qb:DataSet ;
    rdfs:range qb:Slice ;
    rdfs:isDefinedBy <http://purl.org/linked-data/cube> .

qb:sliceStructure a owl:ObjectProperty ;
    rdfs:label "slice structure"@en ;
    rdfs:domain qb:Slice ;
    rdfs:range qb:SliceKey ;
    rdfs:isDefinedBy <http://purl.org/linked-data/cube> .

qb:componentProperty a owl:ObjectProperty ;
    rdfs:label "component"@en ;
    rdfs:isDefinedBy <http://purl.org/linked-data/cube> .

sdmx-attribute:confStatus a owl:ObjectProperty ;
    rdfs:label "confidentiality status"@en ;
    rdfs:comment "Set to sdmx-code:confStatus-C (confidential) on NDB cells and totals that MHLW masked. NDB does not say whether a cell was masked for being small (primary) or to protect another cell (secondary), so the generic code is used."@en ;
    rdfs:isDefinedBy <http://purl.org/linked-data/sdmx/2009/attribute> .

sdmx-code:confStatus-C a owl:NamedIndividual ;
    rdfs:label "confidential"@en , "秘匿"@ja ;
    rdfs:isDefinedBy <http://purl.org/linked-data/sdmx/2009/code> .

# Therapeutic class concepts referenced by the defined classes; the SKOS scheme defines them fully.
dmtc:SGLT2Inhibitor a owl:NamedIndividual , dm:TherapeuticClass .
dmtc:GLP1ReceptorAgonist a owl:NamedIndividual , dm:TherapeuticClass .
