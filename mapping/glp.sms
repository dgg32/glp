;

MAPPING <https://dgg32.github.io/glp/mapping/glp#UsProductSubstance>
FROM SQL {
  SELECT PRODUCT_ID AS "id", SUBSTANCE_ID AS "substance_id" FROM GLP.US.PRODUCT_SUBSTANCE
}
TO {
  ?subject dm:hasActiveSubstance ?o1 .
}
WHERE {
  BIND(template("https://dgg32.github.io/glp/data/product/{id}") AS ?subject)
  BIND(template("https://dgg32.github.io/glp/vocab/substance/{substance_id}") AS ?o1)
}
