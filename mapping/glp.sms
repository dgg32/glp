MAPPING <https://dgg32.github.io/glp/mapping/glp#CareSetting>
FROM SQL {
  SELECT CARE_SETTING_ID AS "id", BROADER_CARE_SETTING_ID AS "broader", DEFINITION_EN AS "definition" FROM GLP.VOCAB.CARE_SETTING
}
TO {
  ?subject a skos:Concept .
  ?subject a dm:CareSetting .
  ?subject skos:inScheme <https://dgg32.github.io/glp/vocab/care-setting> .
  ?subject skos:broader ?o2 .
  ?subject skos:definition ?o3 .
}
WHERE {
  BIND(template("https://dgg32.github.io/glp/vocab/care-setting/{id}") AS ?subject)
  BIND(template("https://dgg32.github.io/glp/vocab/care-setting/{broader}") AS ?o2)
  BIND(strlang(?definition, "en") AS ?o3)
}

;

