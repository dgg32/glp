MAPPING <https://dgg32.github.io/glp/mapping/glp#JpOrganization>
FROM SQL {
  SELECT ORGANIZATION_ID AS "id", NAME_EN AS "en", NAME_JA AS "ja", CORPORATE_GROUP_ID AS "grp" FROM GLP.JP.ORGANIZATION
}
TO {
  ?subject a dm:Organization .
  ?subject rdfs:label ?o1 .
  ?subject rdfs:label ?o2 .
  ?subject dm:partOfCorporateGroup ?o3 .
}
WHERE {
  BIND(template("https://dgg32.github.io/glp/data/organization/jp/{id}") AS ?subject)
  BIND(strlang(?en, "en") AS ?o1)
  BIND(strlang(?ja, "ja") AS ?o2)
  BIND(template("https://dgg32.github.io/glp/data/organization/{grp}") AS ?o3)
}

;

MAPPING <https://dgg32.github.io/glp/mapping/glp#JpProduct>
FROM SQL {
  SELECT PRODUCT_ID AS "id", PRODUCT_NAME_JA AS "name", CASE WHEN PRODUCT_NAME <> PRODUCT_NAME_JA THEN PRODUCT_NAME ELSE NULL END AS "hidden", YJ_CODE AS "yj", JP_CLASS_CODE AS "jp_class", NHI_PRICE AS "price", DISPENSING_UNIT AS "unit", ROUTE AS "route", CASE WHEN IS_GENERIC THEN 'true' ELSE 'false' END AS "generic", CASE WHEN IS_ORIGINATOR THEN 'true' ELSE 'false' END AS "originator", CASE WHEN IS_COMBINATION THEN 'true' ELSE 'false' END AS "combination", ORGANIZATION_ID AS "organization_id" FROM GLP.JP.PRODUCT
}
TO {
  ?subject a dm:MedicinalProduct .
  ?subject rdfs:label ?o1 .
  ?subject skos:hiddenLabel ?o2 .
  ?subject dm:receiptCode ?id .
  ?subject dm:yjCode ?yj .
  ?subject dm:inJapaneseDrugClass ?o5 .
  ?subject dm:nhiPrice ?o6 .
  ?subject dm:dispensingUnit ?unit .
  ?subject dm:routeOfAdministration ?route .
  ?subject dm:isGeneric ?o9 .
  ?subject dm:isOriginator ?o10 .
  ?subject dm:isCombinationProduct ?o11 .
  ?subject dm:manufacturedBy ?o12 .
}
WHERE {
  BIND(template("https://dgg32.github.io/glp/data/product/jp/{id}") AS ?subject)
  BIND(strlang(?name, "ja") AS ?o1)
  BIND(strlang(?hidden, "ja") AS ?o2)
  BIND(template("https://dgg32.github.io/glp/vocab/jp-drug-class/{jp_class}") AS ?o5)
  BIND(strdt(?price, xsd:decimal) AS ?o6)
  BIND(strdt(?generic, xsd:boolean) AS ?o9)
  BIND(strdt(?originator, xsd:boolean) AS ?o10)
  BIND(strdt(?combination, xsd:boolean) AS ?o11)
  BIND(template("https://dgg32.github.io/glp/data/organization/jp/{organization_id}") AS ?o12)
}

;

MAPPING <https://dgg32.github.io/glp/mapping/glp#JpProductSubstance>
FROM SQL {
  SELECT PRODUCT_ID AS "id", SUBSTANCE_ID AS "substance_id" FROM GLP.JP.PRODUCT_SUBSTANCE
}
TO {
  ?subject dm:hasActiveSubstance ?o1 .
}
WHERE {
  BIND(template("https://dgg32.github.io/glp/data/product/jp/{id}") AS ?subject)
  BIND(template("https://dgg32.github.io/glp/vocab/substance/{substance_id}") AS ?o1)
}

;

MAPPING <https://dgg32.github.io/glp/mapping/glp#MonthObservation>
FROM SQL {
  SELECT PRODUCT_ID AS "product_id", CARE_SETTING_ID AS "setting", CELL AS "cell", CELL AS "dim", QUANTITY AS "quantity" FROM GLP.JP.QUANTITY WHERE BREAKDOWN = 'month'
}
TO {
  ?subject dm:month ?o1 .
  ?subject dm:quantity ?o2 .
}
WHERE {
  BIND(template("https://dgg32.github.io/glp/data/ndb/11/obs/{product_id}/{setting}/{cell}") AS ?subject)
  BIND(strdt(?dim, xsd:gYearMonth) AS ?o1)
  BIND(strdt(?quantity, xsd:decimal) AS ?o2)
}

;

MAPPING <https://dgg32.github.io/glp/mapping/glp#MonthSlice>
FROM SQL {
  SELECT PRODUCT_ID AS "product_id", CARE_SETTING_ID AS "setting", TOTAL_QUANTITY AS "total" FROM GLP.JP.NATIONAL_TOTAL
}
TO {
  ?subject a dm:QuantitySlice .
  ?subject qb:sliceStructure <https://dgg32.github.io/glp/data/ndb/key/month> .
  ?subject dm:aboutProduct ?o2 .
  ?subject dm:careSetting ?o3 .
  ?subject dm:totalQuantity ?o4 .
}
WHERE {
  BIND(template("https://dgg32.github.io/glp/data/ndb/11/slice/{product_id}/{setting}/month") AS ?subject)
  BIND(template("https://dgg32.github.io/glp/data/product/jp/{product_id}") AS ?o2)
  BIND(template("https://dgg32.github.io/glp/vocab/care-setting/{setting}") AS ?o3)
  BIND(strdt(?total, xsd:decimal) AS ?o4)
}

;

MAPPING <https://dgg32.github.io/glp/mapping/glp#MonthSliceMasked>
FROM SQL {
  SELECT PRODUCT_ID AS "product_id", CARE_SETTING_ID AS "setting" FROM GLP.JP.NATIONAL_TOTAL WHERE IS_MASKED
}
TO {
  ?subject sdmx-attribute:confStatus sdmx-code:confStatus-C .
}
WHERE {
  BIND(template("https://dgg32.github.io/glp/data/ndb/11/slice/{product_id}/{setting}/month") AS ?subject)
}

;

MAPPING <https://dgg32.github.io/glp/mapping/glp#MonthSliceObservation>
FROM SQL {
  SELECT PRODUCT_ID AS "product_id", CARE_SETTING_ID AS "setting", CELL AS "cell" FROM GLP.JP.QUANTITY WHERE BREAKDOWN = 'month'
}
TO {
