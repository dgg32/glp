MAPPING <https://dgg32.github.io/glp/mapping/glp#TherapeuticClassTop>
FROM SQL {
  SELECT CLASS_ID AS "id" FROM GLP.VOCAB.THERAPEUTIC_CLASS WHERE BROADER_CLASS_ID IS NULL
}
TO {
  ?subject skos:topConceptOf <https://dgg32.github.io/glp/vocab/therapeutic-class> .
}
WHERE {
  BIND(template("https://dgg32.github.io/glp/vocab/therapeutic-class/{id}") AS ?subject)
}

;

MAPPING <https://dgg32.github.io/glp/mapping/glp#UsOrganization>
FROM SQL {
  SELECT ORGANIZATION_ID AS "id", NAME_EN AS "en", NAME_JA AS "ja", NAME_ZH AS "zh", LEI AS "lei" FROM GLP.US.ORGANIZATION
}
TO {
  ?subject a dm:Organization .
  ?subject rdfs:label ?o1 .
  ?subject rdfs:label ?o2 .
  ?subject rdfs:label ?o3 .
  ?subject dcterms:identifier ?lei .
}
WHERE {
  BIND(template("https://dgg32.github.io/glp/data/organization/{id}") AS ?subject)
  BIND(strlang(?en, "en") AS ?o1)
  BIND(strlang(?ja, "ja") AS ?o2)
  BIND(strlang(?zh, "zh") AS ?o3)
}

;

MAPPING <https://dgg32.github.io/glp/mapping/glp#UsProduct>
FROM SQL {
  SELECT PRODUCT_ID AS "id", BRAND_NAME AS "brand", CMS_GENERIC_NAME AS "generic", CASE WHEN IS_COMBINATION THEN 'true' ELSE 'false' END AS "combination" FROM GLP.US.PRODUCT
}
TO {
  ?subject a dm:MedicinalProduct .
  ?subject rdfs:label ?o1 .
  ?subject dm:cmsGenericName ?generic .
  ?subject dm:isCombinationProduct ?o3 .
}
WHERE {
  BIND(template("https://dgg32.github.io/glp/data/product/{id}") AS ?subject)
  BIND(strlang(?brand, "en") AS ?o1)
  BIND(strdt(?combination, xsd:boolean) AS ?o3)
}

;

MAPPING <https://dgg32.github.io/glp/mapping/glp#UsProductIndication>
FROM SQL {
  SELECT PRODUCT_ID AS "id", INDICATION_ID AS "indication_id" FROM GLP.US.PRODUCT_INDICATION
}
TO {
  ?subject dm:hasIndication ?o1 .
}
WHERE {
  BIND(template("https://dgg32.github.io/glp/data/product/{id}") AS ?subject)
  BIND(template("https://dgg32.github.io/glp/vocab/indication/{indication_id}") AS ?o1)
}

;

MAPPING <https://dgg32.github.io/glp/mapping/glp#UsProductManufacturer>
FROM SQL {
