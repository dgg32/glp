;

MAPPING <https://dgg32.github.io/glp/mapping/glp#TherapeuticClass>
FROM SQL {
  SELECT CLASS_ID AS "id", BROADER_CLASS_ID AS "broader", NOTATION AS "notation", DEFINITION_EN AS "definition", NOTATION AS "atc" FROM GLP.VOCAB.THERAPEUTIC_CLASS
}
TO {
  ?subject a skos:Concept .
  ?subject a dm:TherapeuticClass .
  ?subject skos:exactMatch ?o1 .
  ?subject skos:inScheme <https://dgg32.github.io/glp/vocab/therapeutic-class> .
  ?subject skos:broader ?o3 .
  ?subject skos:notation ?notation .
  ?subject skos:definition ?o5 .
}
WHERE {
  BIND(template("https://dgg32.github.io/glp/vocab/therapeutic-class/{id}") AS ?subject)
  BIND(template("http://purl.bioontology.org/ontology/ATC/{atc}") AS ?o1)
  BIND(template("https://dgg32.github.io/glp/vocab/therapeutic-class/{broader}") AS ?o3)
  BIND(strlang(?definition, "en") AS ?o5)
}

;

