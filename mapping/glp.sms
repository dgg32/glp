}
WHERE {
  BIND(template("https://dgg32.github.io/glp/data/ndb/11/slice/{product_id}/{setting}/month") AS ?subject)
  BIND(template("https://dgg32.github.io/glp/data/ndb/11/obs/{product_id}/{setting}/{cell}") AS ?o1)
}

;

MAPPING <https://dgg32.github.io/glp/mapping/glp#ObservationMasked>
FROM SQL {
  SELECT PRODUCT_ID AS "product_id", CARE_SETTING_ID AS "setting", CELL AS "cell" FROM GLP.JP.QUANTITY WHERE IS_MASKED
}
TO {
  ?subject sdmx-attribute:confStatus sdmx-code:confStatus-C .
}
WHERE {
  BIND(template("https://dgg32.github.io/glp/data/ndb/11/obs/{product_id}/{setting}/{cell}") AS ?subject)
}

;

MAPPING <https://dgg32.github.io/glp/mapping/glp#Prefecture>
FROM SQL {
  SELECT PREFECTURE_CODE AS "id", PREFECTURE_CODE AS "notation", ISO_CODE AS "iso_code", WIKIDATA_ID AS "wikidata_id" FROM GLP.VOCAB.PREFECTURE
}
TO {
  ?subject a skos:Concept .
  ?subject a dm:Prefecture .
  ?subject skos:inScheme <https://dgg32.github.io/glp/vocab/prefecture> .
  ?subject skos:notation ?notation .
  ?subject dcterms:identifier ?iso_code .
  ?subject skos:exactMatch ?o4 .
}
WHERE {
  BIND(template("https://dgg32.github.io/glp/vocab/prefecture/{id}") AS ?subject)
  BIND(template("http://www.wikidata.org/entity/{wikidata_id}") AS ?o4)
}

;

MAPPING <https://dgg32.github.io/glp/mapping/glp#PrefectureAltLabelEn>
FROM SQL {
  SELECT CONCEPT_ID AS "id", LABEL AS "label" FROM GLP.VOCAB.LABEL WHERE CONCEPT_KIND = 'prefecture' AND LABEL_TYPE = 'alt' AND "LANGUAGE" = 'en'
}
TO {
