MAPPING <https://dgg32.github.io/glp/mapping/glp#Prescriber>
FROM SQL {
  SELECT PRESCRIBER_ID AS "id", CMS_PRESCRIBER_TYPE AS "type", CITY AS "city", STATE AS "state", PRIMARY_SPECIALTY_CODE AS "primary" FROM GLP.US.PRESCRIBER
}
TO {
  ?subject a dm:HealthcareProfessional .
  ?subject dm:pseudonymousId ?id .
  ?subject dm:cmsPrescriberType ?type .
  ?subject dm:city ?city .
  ?subject dm:state ?state .
  ?subject dm:hasPrimarySpecialty ?o5 .
}
WHERE {
  BIND(template("https://dgg32.github.io/glp/data/hcp/{id}") AS ?subject)
  BIND(template("https://dgg32.github.io/glp/vocab/specialty/{primary}") AS ?o5)
}

;

MAPPING <https://dgg32.github.io/glp/mapping/glp#PrescriberSpecialty>
FROM SQL {
  SELECT PRESCRIBER_ID AS "id", SPECIALTY_CODE AS "specialty" FROM GLP.US.PRESCRIBER_SPECIALTY
}
TO {
  ?subject dm:hasSpecialty ?o1 .
}
WHERE {
  BIND(template("https://dgg32.github.io/glp/data/hcp/{id}") AS ?subject)
  BIND(template("https://dgg32.github.io/glp/vocab/specialty/{specialty}") AS ?o1)
}

;

MAPPING <https://dgg32.github.io/glp/mapping/glp#Prescription>
FROM SQL {
  SELECT DATA_YEAR AS "year", PRESCRIBER_ID AS "prescriber_id", PRODUCT_ID AS "product_id", TOTAL_CLAIMS AS "claims", TOTAL_30DAY_FILLS AS "fills", CAST(TOTAL_DAY_SUPPLY AS VARCHAR) AS "supply", TOTAL_DRUG_COST AS "cost", CAST(TOTAL_BENEFICIARIES AS VARCHAR) AS "benes", CASE WHEN BENEFICIARIES_SUPPRESSED THEN 'true' ELSE 'false' END AS "suppressed" FROM GLP.US.PRESCRIPTION
}
TO {
  ?subject a dm:Prescription .
  ?subject dm:prescribedBy ?o1 .
  ?subject dm:forProduct ?o2 .
  ?subject dm:dataYear ?o3 .
  ?subject dm:totalClaims ?o4 .
  ?subject dm:total30DayFills ?o5 .
  ?subject dm:totalDaySupply ?o6 .
  ?subject dm:totalDrugCost ?o7 .
  ?subject dm:totalBeneficiaries ?o8 .
  ?subject dm:beneficiaryCountSuppressed ?o9 .
}
WHERE {
  BIND(template("https://dgg32.github.io/glp/data/rx/{year}/{prescriber_id}/{product_id}") AS ?subject)
  BIND(template("https://dgg32.github.io/glp/data/hcp/{prescriber_id}") AS ?o1)
  BIND(template("https://dgg32.github.io/glp/data/product/{product_id}") AS ?o2)
  BIND(strdt(?year, xsd:gYear) AS ?o3)
  BIND(strdt(?claims, xsd:integer) AS ?o4)
  BIND(strdt(?fills, xsd:decimal) AS ?o5)
  BIND(strdt(?supply, xsd:integer) AS ?o6)
  BIND(strdt(?cost, xsd:decimal) AS ?o7)
  BIND(strdt(?benes, xsd:integer) AS ?o8)
  BIND(strdt(?suppressed, xsd:boolean) AS ?o9)
}

;

