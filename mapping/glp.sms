MAPPING <https://dgg32.github.io/glp/mapping/glp#TherapeuticClassAncestor>
FROM SQL {
  SELECT CLASS_ID AS "id", ANCESTOR_CLASS_ID AS "ancestor" FROM GLP.VOCAB.CLASS_ANCESTOR WHERE CLASS_ID <> ANCESTOR_CLASS_ID
}
TO {
  ?subject skos:broaderTransitive ?o1 .
}
WHERE {
  BIND(template("https://dgg32.github.io/glp/vocab/therapeutic-class/{id}") AS ?subject)
  BIND(template("https://dgg32.github.io/glp/vocab/therapeutic-class/{ancestor}") AS ?o1)
}

;

