MAPPING <https://dgg32.github.io/glp/mapping/glp#SubstanceAltLabelZh>
FROM SQL {
  SELECT CONCEPT_ID AS "id", LABEL AS "label" FROM GLP.VOCAB.LABEL WHERE CONCEPT_KIND = 'substance' AND LABEL_TYPE = 'alt' AND "LANGUAGE" = 'zh'
}
TO {
  ?subject skos:altLabel ?o1 .
}
WHERE {
  BIND(template("https://dgg32.github.io/glp/vocab/substance/{id}") AS ?subject)
  BIND(strlang(?label, "zh") AS ?o1)
}

;

