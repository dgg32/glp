    rr:subjectMap [
        rr:template "https://dgg32.github.io/glp/data/ndb/11/slice/{product_id}/{setting}/prefecture" ] ;
    rr:predicateObjectMap [ rr:predicate qb:observation ;
        rr:objectMap [ rr:template "https://dgg32.github.io/glp/data/ndb/11/obs/{product_id}/{setting}/{cell}" ] ] .

map:PrefectureObservation a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery """SELECT PRODUCT_ID AS "product_id", CARE_SETTING_ID AS "setting", CELL AS "cell", PREFECTURE_CODE AS "dim", QUANTITY AS "quantity" FROM GLP.JP.QUANTITY WHERE BREAKDOWN = 'prefecture'""" ] ;
