map:Specialty a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery """SELECT SPECIALTY_CODE AS "id", BROADER_SPECIALTY_CODE AS "broader", CASE WHEN SPECIALTY_CODE LIKE 'grouping-%' OR SPECIALTY_CODE LIKE 'classification-%' THEN NULL ELSE SPECIALTY_CODE END AS "notation", DEFINITION_EN AS "definition" FROM GLP.VOCAB.SPECIALTY""" ] ;
    rr:subjectMap [
        rr:template "https://dgg32.github.io/glp/vocab/specialty/{id}" ;
        rr:class skos:Concept , dm:Specialty ] ;
    rr:predicateObjectMap [ rr:predicate skos:inScheme ;
        rr:object <https://dgg32.github.io/glp/vocab/specialty> ] ;
    rr:predicateObjectMap [ rr:predicate skos:broader ;
        rr:objectMap [ rr:template "https://dgg32.github.io/glp/vocab/specialty/{broader}" ] ] ;
    rr:predicateObjectMap [ rr:predicate skos:notation ;
        rr:objectMap [ rr:column "notation" ] ] ;
    rr:predicateObjectMap [ rr:predicate skos:definition ;
        rr:objectMap [ rr:column "definition" ; rr:language "en" ] ] .

map:SpecialtyTop a rr:TriplesMap ;
