# === Medicare Part D, Connecticut (schema US) ============================================================

map:UsOrganization a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery """SELECT ORGANIZATION_ID AS "id", NAME_EN AS "en", NAME_JA AS "ja", NAME_ZH AS "zh", LEI AS "lei" FROM GLP.US.ORGANIZATION""" ] ;
    rr:subjectMap [
        rr:template "https://dgg32.github.io/glp/data/organization/{id}" ;
        rr:class dm:Organization ] ;
    rr:predicateObjectMap [ rr:predicate rdfs:label ;
        rr:objectMap [ rr:column "en" ; rr:language "en" ] ] ;
    rr:predicateObjectMap [ rr:predicate rdfs:label ;
        rr:objectMap [ rr:column "ja" ; rr:language "ja" ] ] ;
    rr:predicateObjectMap [ rr:predicate rdfs:label ;
        rr:objectMap [ rr:column "zh" ; rr:language "zh" ] ] ;
    rr:predicateObjectMap [ rr:predicate dcterms:identifier ;
        rr:objectMap [ rr:column "lei" ] ] .

map:UsProduct a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery """SELECT PRODUCT_ID AS "id", BRAND_NAME AS "brand", CMS_GENERIC_NAME AS "generic", CASE WHEN IS_COMBINATION THEN 'true' ELSE 'false' END AS "combination" FROM GLP.US.PRODUCT""" ] ;
    rr:subjectMap [
        rr:template "https://dgg32.github.io/glp/data/product/{id}" ;
        rr:class dm:MedicinalProduct ] ;
    rr:predicateObjectMap [ rr:predicate rdfs:label ;
        rr:objectMap [ rr:column "brand" ; rr:language "en" ] ] ;
    rr:predicateObjectMap [ rr:predicate dm:cmsGenericName ;
        rr:objectMap [ rr:column "generic" ] ] ;
    rr:predicateObjectMap [ rr:predicate dm:isCombinationProduct ;
        rr:objectMap [ rr:column "combination" ; rr:datatype xsd:boolean ] ] .

map:UsProductSubstance a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery """SELECT PRODUCT_ID AS "id", SUBSTANCE_ID AS "substance_id" FROM GLP.US.PRODUCT_SUBSTANCE""" ] ;
    rr:subjectMap [
        rr:template "https://dgg32.github.io/glp/data/product/{id}" ] ;
    rr:predicateObjectMap [ rr:predicate dm:hasActiveSubstance ;
        rr:objectMap [ rr:template "https://dgg32.github.io/glp/vocab/substance/{substance_id}" ] ] .

map:UsProductIndication a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery """SELECT PRODUCT_ID AS "id", INDICATION_ID AS "indication_id" FROM GLP.US.PRODUCT_INDICATION""" ] ;
    rr:subjectMap [
        rr:template "https://dgg32.github.io/glp/data/product/{id}" ] ;
    rr:predicateObjectMap [ rr:predicate dm:hasIndication ;
        rr:objectMap [ rr:template "https://dgg32.github.io/glp/vocab/indication/{indication_id}" ] ] .

map:UsProductManufacturer a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery """SELECT PRODUCT_ID AS "id", ORGANIZATION_ID AS "organization_id" FROM GLP.US.PRODUCT_MANUFACTURER""" ] ;
    rr:subjectMap [
        rr:template "https://dgg32.github.io/glp/data/product/{id}" ] ;
    rr:predicateObjectMap [ rr:predicate dm:manufacturedBy ;
        rr:objectMap [ rr:template "https://dgg32.github.io/glp/data/organization/{organization_id}" ] ] .

map:Prescriber a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery """SELECT PRESCRIBER_ID AS "id", CMS_PRESCRIBER_TYPE AS "type", CITY AS "city", STATE AS "state", PRIMARY_SPECIALTY_CODE AS "primary" FROM GLP.US.PRESCRIBER""" ] ;
    rr:subjectMap [
        rr:template "https://dgg32.github.io/glp/data/hcp/{id}" ;
        rr:class dm:HealthcareProfessional ] ;
    rr:predicateObjectMap [ rr:predicate dm:pseudonymousId ;
        rr:objectMap [ rr:column "id" ] ] ;
    rr:predicateObjectMap [ rr:predicate dm:cmsPrescriberType ;
        rr:objectMap [ rr:column "type" ] ] ;
    rr:predicateObjectMap [ rr:predicate dm:city ;
        rr:objectMap [ rr:column "city" ] ] ;
    rr:predicateObjectMap [ rr:predicate dm:state ;
        rr:objectMap [ rr:column "state" ] ] ;
    rr:predicateObjectMap [ rr:predicate dm:hasPrimarySpecialty ;
        rr:objectMap [ rr:template "https://dgg32.github.io/glp/vocab/specialty/{primary}" ] ] .

map:PrescriberSpecialty a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery """SELECT PRESCRIBER_ID AS "id", SPECIALTY_CODE AS "specialty" FROM GLP.US.PRESCRIBER_SPECIALTY""" ] ;
    rr:subjectMap [
        rr:template "https://dgg32.github.io/glp/data/hcp/{id}" ] ;
    rr:predicateObjectMap [ rr:predicate dm:hasSpecialty ;
        rr:objectMap [ rr:template "https://dgg32.github.io/glp/vocab/specialty/{specialty}" ] ] .

map:Prescription a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery """SELECT DATA_YEAR AS "year", PRESCRIBER_ID AS "prescriber_id", PRODUCT_ID AS "product_id", TOTAL_CLAIMS AS "claims", TOTAL_30DAY_FILLS AS "fills", CAST(TOTAL_DAY_SUPPLY AS VARCHAR) AS "supply", TOTAL_DRUG_COST AS "cost", CAST(TOTAL_BENEFICIARIES AS VARCHAR) AS "benes", CASE WHEN BENEFICIARIES_SUPPRESSED THEN 'true' ELSE 'false' END AS "suppressed" FROM GLP.US.PRESCRIPTION""" ] ;
    rr:subjectMap [
        rr:template "https://dgg32.github.io/glp/data/rx/{year}/{prescriber_id}/{product_id}" ;
        rr:class dm:Prescription ] ;
    rr:predicateObjectMap [ rr:predicate dm:prescribedBy ;
        rr:objectMap [ rr:template "https://dgg32.github.io/glp/data/hcp/{prescriber_id}" ] ] ;
    rr:predicateObjectMap [ rr:predicate dm:forProduct ;
        rr:objectMap [ rr:template "https://dgg32.github.io/glp/data/product/{product_id}" ] ] ;
    rr:predicateObjectMap [ rr:predicate dm:dataYear ;
        rr:objectMap [ rr:column "year" ; rr:datatype xsd:gYear ] ] ;
    rr:predicateObjectMap [ rr:predicate dm:totalClaims ;
        rr:objectMap [ rr:column "claims" ; rr:datatype xsd:integer ] ] ;
    rr:predicateObjectMap [ rr:predicate dm:total30DayFills ;
        rr:objectMap [ rr:column "fills" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate dm:totalDaySupply ;
        rr:objectMap [ rr:column "supply" ; rr:datatype xsd:integer ] ] ;
    rr:predicateObjectMap [ rr:predicate dm:totalDrugCost ;
        rr:objectMap [ rr:column "cost" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate dm:totalBeneficiaries ;
        rr:objectMap [ rr:column "benes" ; rr:datatype xsd:integer ] ] ;
    rr:predicateObjectMap [ rr:predicate dm:beneficiaryCountSuppressed ;
        rr:objectMap [ rr:column "suppressed" ; rr:datatype xsd:boolean ] ] .

# === NDB Open Data, Japan, as an RDF Data Cube (schema JP) ===============================================

map:JpOrganization a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery """SELECT ORGANIZATION_ID AS "id", NAME_EN AS "en", NAME_JA AS "ja", CORPORATE_GROUP_ID AS "grp" FROM GLP.JP.ORGANIZATION""" ] ;
    rr:subjectMap [
        rr:template "https://dgg32.github.io/glp/data/organization/jp/{id}" ;
        rr:class dm:Organization ] ;
    rr:predicateObjectMap [ rr:predicate rdfs:label ;
        rr:objectMap [ rr:column "en" ; rr:language "en" ] ] ;
    rr:predicateObjectMap [ rr:predicate rdfs:label ;
        rr:objectMap [ rr:column "ja" ; rr:language "ja" ] ] ;
    rr:predicateObjectMap [ rr:predicate dm:partOfCorporateGroup ;
        rr:objectMap [ rr:template "https://dgg32.github.io/glp/data/organization/{grp}" ] ] .

map:JpProduct a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery """SELECT PRODUCT_ID AS "id", PRODUCT_NAME_JA AS "name", CASE WHEN PRODUCT_NAME <> PRODUCT_NAME_JA THEN PRODUCT_NAME ELSE NULL END AS "hidden", YJ_CODE AS "yj", JP_CLASS_CODE AS "jp_class", NHI_PRICE AS "price", DISPENSING_UNIT AS "unit", ROUTE AS "route", CASE WHEN IS_GENERIC THEN 'true' ELSE 'false' END AS "generic", CASE WHEN IS_ORIGINATOR THEN 'true' ELSE 'false' END AS "originator", CASE WHEN IS_COMBINATION THEN 'true' ELSE 'false' END AS "combination", ORGANIZATION_ID AS "organization_id" FROM GLP.JP.PRODUCT""" ] ;
    rr:subjectMap [
        rr:template "https://dgg32.github.io/glp/data/product/jp/{id}" ;
        rr:class dm:MedicinalProduct ] ;
    rr:predicateObjectMap [ rr:predicate rdfs:label ;
        rr:objectMap [ rr:column "name" ; rr:language "ja" ] ] ;
    rr:predicateObjectMap [ rr:predicate skos:hiddenLabel ;
        rr:objectMap [ rr:column "hidden" ; rr:language "ja" ] ] ;
    rr:predicateObjectMap [ rr:predicate dm:receiptCode ;
        rr:objectMap [ rr:column "id" ] ] ;
    rr:predicateObjectMap [ rr:predicate dm:yjCode ;
        rr:objectMap [ rr:column "yj" ] ] ;
    rr:predicateObjectMap [ rr:predicate dm:inJapaneseDrugClass ;
        rr:objectMap [ rr:template "https://dgg32.github.io/glp/vocab/jp-drug-class/{jp_class}" ] ] ;
    rr:predicateObjectMap [ rr:predicate dm:nhiPrice ;
        rr:objectMap [ rr:column "price" ; rr:datatype xsd:decimal ] ] ;
    rr:predicateObjectMap [ rr:predicate dm:dispensingUnit ;
        rr:objectMap [ rr:column "unit" ] ] ;
    rr:predicateObjectMap [ rr:predicate dm:routeOfAdministration ;
        rr:objectMap [ rr:column "route" ] ] ;
    rr:predicateObjectMap [ rr:predicate dm:isGeneric ;
        rr:objectMap [ rr:column "generic" ; rr:datatype xsd:boolean ] ] ;
    rr:predicateObjectMap [ rr:predicate dm:isOriginator ;
        rr:objectMap [ rr:column "originator" ; rr:datatype xsd:boolean ] ] ;
    rr:predicateObjectMap [ rr:predicate dm:isCombinationProduct ;
        rr:objectMap [ rr:column "combination" ; rr:datatype xsd:boolean ] ] ;
    rr:predicateObjectMap [ rr:predicate dm:manufacturedBy ;
        rr:objectMap [ rr:template "https://dgg32.github.io/glp/data/organization/jp/{organization_id}" ] ] .

map:JpProductSubstance a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery """SELECT PRODUCT_ID AS "id", SUBSTANCE_ID AS "substance_id" FROM GLP.JP.PRODUCT_SUBSTANCE""" ] ;
    rr:subjectMap [
        rr:template "https://dgg32.github.io/glp/data/product/jp/{id}" ] ;
    rr:predicateObjectMap [ rr:predicate dm:hasActiveSubstance ;
        rr:objectMap [ rr:template "https://dgg32.github.io/glp/vocab/substance/{substance_id}" ] ] .

map:ObservationMasked a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery """SELECT PRODUCT_ID AS "product_id", CARE_SETTING_ID AS "setting", CELL AS "cell" FROM GLP.JP.QUANTITY WHERE IS_MASKED""" ] ;
    rr:subjectMap [
        rr:template "https://dgg32.github.io/glp/data/ndb/11/obs/{product_id}/{setting}/{cell}" ] ;
    rr:predicateObjectMap [ rr:predicate sdmx-attribute:confStatus ;
        rr:object sdmx-code:confStatus-C ] .

map:PrefectureSlice a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery """SELECT PRODUCT_ID AS "product_id", CARE_SETTING_ID AS "setting", TOTAL_QUANTITY AS "total" FROM GLP.JP.NATIONAL_TOTAL""" ] ;
