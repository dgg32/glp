map:Substance a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery """SELECT SUBSTANCE_ID AS "id", CLASS_ID AS "class_id" FROM GLP.VOCAB.SUBSTANCE""" ] ;
    rr:subjectMap [
        rr:template "https://dgg32.github.io/glp/vocab/substance/{id}" ;
        rr:class skos:Concept , dm:Substance ] ;
    rr:predicateObjectMap [ rr:predicate skos:inScheme ;
        rr:object <https://dgg32.github.io/glp/vocab/substance> ] ;
    rr:predicateObjectMap [ rr:predicate dm:inTherapeuticClass ;
        rr:objectMap [ rr:template "https://dgg32.github.io/glp/vocab/therapeutic-class/{class_id}" ] ] .

map:SubstanceTop a rr:TriplesMap ;
