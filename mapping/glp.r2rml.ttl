# R2RML mapping of the knowledge graph over the Snowflake tables (GLP.VOCAB, GLP.US, GLP.JP).
# Generated by scripts/build_mapping.py: edit the spec there, not this file. Checked against the graph by
# scripts/check_mapping.py (Morph-KGC); scripts/r2rml_to_sms2.py writes the SMS2 that Stardog Studio reads.

@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix qb: <http://purl.org/linked-data/cube#> .
@prefix sdmx-attribute: <http://purl.org/linked-data/sdmx/2009/attribute#> .
@prefix sdmx-code: <http://purl.org/linked-data/sdmx/2009/code#> .
@prefix dm: <https://dgg32.github.io/glp/ontology#> .
@prefix map: <https://dgg32.github.io/glp/mapping/glp#> .

# === SKOS vocabularies (schema VOCAB) ====================================================================

map:TherapeuticClass a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery """SELECT CLASS_ID AS "id", BROADER_CLASS_ID AS "broader", NOTATION AS "notation", DEFINITION_EN AS "definition", NOTATION AS "atc" FROM GLP.VOCAB.THERAPEUTIC_CLASS""" ] ;
    rr:subjectMap [
        rr:template "https://dgg32.github.io/glp/vocab/therapeutic-class/{id}" ;
        rr:class skos:Concept , dm:TherapeuticClass ] ;
    rr:predicateObjectMap [ rr:predicate skos:inScheme ;
        rr:object <https://dgg32.github.io/glp/vocab/therapeutic-class> ] ;
    rr:predicateObjectMap [ rr:predicate skos:broader ;
        rr:objectMap [ rr:template "https://dgg32.github.io/glp/vocab/therapeutic-class/{broader}" ] ] ;
    rr:predicateObjectMap [ rr:predicate skos:notation ;
        rr:objectMap [ rr:column "notation" ] ] ;
    rr:predicateObjectMap [ rr:predicate skos:definition ;
        rr:objectMap [ rr:column "definition" ; rr:language "en" ] ] ;
    rr:predicateObjectMap [ rr:predicate skos:exactMatch ;
        rr:objectMap [ rr:template "http://purl.bioontology.org/ontology/ATC/{atc}" ] ] .

map:TherapeuticClassTop a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery """SELECT CLASS_ID AS "id" FROM GLP.VOCAB.THERAPEUTIC_CLASS WHERE BROADER_CLASS_ID IS NULL""" ] ;
    rr:subjectMap [
        rr:template "https://dgg32.github.io/glp/vocab/therapeutic-class/{id}" ] ;
    rr:predicateObjectMap [ rr:predicate skos:topConceptOf ;
        rr:object <https://dgg32.github.io/glp/vocab/therapeutic-class> ] .

map:TherapeuticClassAncestor a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery """SELECT CLASS_ID AS "id", ANCESTOR_CLASS_ID AS "ancestor" FROM GLP.VOCAB.CLASS_ANCESTOR WHERE CLASS_ID <> ANCESTOR_CLASS_ID""" ] ;
    rr:subjectMap [
        rr:template "https://dgg32.github.io/glp/vocab/therapeutic-class/{id}" ] ;
    rr:predicateObjectMap [ rr:predicate skos:broaderTransitive ;
        rr:objectMap [ rr:template "https://dgg32.github.io/glp/vocab/therapeutic-class/{ancestor}" ] ] .

map:TherapeuticClassPrefLabelEn a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery """SELECT CONCEPT_ID AS "id", LABEL AS "label" FROM GLP.VOCAB.LABEL WHERE CONCEPT_KIND = 'therapeutic_class' AND LABEL_TYPE = 'pref' AND "LANGUAGE" = 'en'""" ] ;
    rr:subjectMap [
        rr:template "https://dgg32.github.io/glp/vocab/therapeutic-class/{id}" ] ;
    rr:predicateObjectMap [ rr:predicate skos:prefLabel , rdfs:label ;
        rr:objectMap [ rr:column "label" ; rr:language "en" ] ] .

map:TherapeuticClassPrefLabelJa a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery """SELECT CONCEPT_ID AS "id", LABEL AS "label" FROM GLP.VOCAB.LABEL WHERE CONCEPT_KIND = 'therapeutic_class' AND LABEL_TYPE = 'pref' AND "LANGUAGE" = 'ja'""" ] ;
    rr:subjectMap [
        rr:template "https://dgg32.github.io/glp/vocab/therapeutic-class/{id}" ] ;
    rr:predicateObjectMap [ rr:predicate skos:prefLabel , rdfs:label ;
        rr:objectMap [ rr:column "label" ; rr:language "ja" ] ] .

