    rr:subjectMap [
        rr:template "https://dgg32.github.io/glp/vocab/specialty/{id}" ] ;
    rr:predicateObjectMap [ rr:predicate skos:broaderTransitive ;
        rr:objectMap [ rr:template "https://dgg32.github.io/glp/vocab/specialty/{ancestor}" ] ] .

