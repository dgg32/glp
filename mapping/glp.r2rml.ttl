        rr:template "https://dgg32.github.io/glp/data/ndb/11/slice/{product_id}/{setting}/prefecture" ;
        rr:class dm:QuantitySlice ] ;
    rr:predicateObjectMap [ rr:predicate qb:sliceStructure ;
        rr:object <https://dgg32.github.io/glp/data/ndb/key/prefecture> ] ;
    rr:predicateObjectMap [ rr:predicate dm:aboutProduct ;
        rr:objectMap [ rr:template "https://dgg32.github.io/glp/data/product/jp/{product_id}" ] ] ;
    rr:predicateObjectMap [ rr:predicate dm:careSetting ;
        rr:objectMap [ rr:template "https://dgg32.github.io/glp/vocab/care-setting/{setting}" ] ] ;
    rr:predicateObjectMap [ rr:predicate dm:totalQuantity ;
        rr:objectMap [ rr:column "total" ; rr:datatype xsd:decimal ] ] .

map:PrefectureSliceMasked a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery """SELECT PRODUCT_ID AS "product_id", CARE_SETTING_ID AS "setting" FROM GLP.JP.NATIONAL_TOTAL WHERE IS_MASKED""" ] ;
