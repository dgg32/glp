# Copy to .env and fill in.
# Secret for pseudonymizing prescriber NPIs (HMAC-SHA256). Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
PSEUDONYM_KEY=

# Stardog Cloud API access (HTTP basic auth)
STARDOG_ENDPOINT=https://<your-endpoint>.stardog.cloud:5820
STARDOG_DATABASE=glp
STARDOG_USERNAME=
STARDOG_PASSWORD=
# Read-only Stardog user for the MCP server (READ on db:glp only)
STARDOG_READER_USERNAME=
STARDOG_READER_PASSWORD=

# UMLS API key (free with a UMLS licence; https://uts.nlm.nih.gov/uts/profile). Used by scripts/resolve_vocab.py.
UMLS_API_KEY=
