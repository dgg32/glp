<https://dgg32.github.io/glp/vocab/jp-drug-class> a skos:ConceptScheme ;
    dcterms:creator "Sixing Huang" ;
    dcterms:description "The therapeutic categories of the Japan Standard Commodity Classification that the diabetes drugs in NDB Open Data are filed under, with SKOS mapping links to the ATC-based therapeutic class scheme. The mappings are computed from the products (scripts/build_ndb.py), not asserted by hand."@en ;
    dcterms:modified "2026-10-31"^^xsd:date ;
    dcterms:title "Japanese therapeutic categories (薬効分類)"@en,
        "薬効分類"@ja,
        "日本药效分类"@zh ;
    skos:hasTopConcept jpc:2,
        jpc:3 ;
    prov:wasDerivedFrom <https://www.mhlw.go.jp/stf/seisakunitsuite/bunya/0000177221_00017.html>,
        <https://www.soumu.go.jp/toukei_toukatsu/index/seido/syouhin/2index.htm> .

