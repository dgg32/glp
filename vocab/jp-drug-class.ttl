    skos:narrower jpc:24 ;
    skos:notation "2" ;
    skos:prefLabel "Drugs for individual organ systems"@en,
        "個々の器官系用医薬品"@ja,
        "各器官系统用药"@zh ;
    skos:topConceptOf <https://dgg32.github.io/glp/vocab/jp-drug-class> .

