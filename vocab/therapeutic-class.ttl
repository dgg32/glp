<https://dgg32.github.io/glp/vocab/therapeutic-class> a skos:ConceptScheme ;
    dcterms:creator "Sixing Huang" ;
    dcterms:description "Drug classes for the type 2 diabetes market, following the WHO ATC A10 tree (as served by RxClass) with one project-specific refinement (dual GIP/GLP-1 agonists under GLP-1 receptor agonists)."@en ;
    dcterms:modified "2026-10-15"^^xsd:date ;
    dcterms:title "Therapeutic classes of diabetes drugs"@en,
        "糖尿病治療薬の薬効分類"@ja,
        "糖尿病治疗药物分类"@zh ;
    skos:editorialNote "Japanese and Chinese labels not taken from Wikidata were drafted 2026-10-14 and are pending native-speaker review (docs/label-review.md)."@en ;
    skos:hasTopConcept dmtc:DrugsUsedInDiabetes ;
    prov:wasDerivedFrom <https://id.nlm.nih.gov/mesh/>,
        <https://lhncbc.nlm.nih.gov/RxNav/applications/RxClassIntro.html>,
        <https://www.nlm.nih.gov/research/umls/> .

