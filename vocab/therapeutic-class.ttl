dmtc:Biguanide a skos:Concept,
        dm:TherapeuticClass ;
    rdfs:label "Biguanides"@en,
        "ビグアナイド薬"@ja,
        "双胍类药物"@zh ;
    skos:altLabel "Biguanide"@en,
        "BG薬"@ja,
        "双胍类"@zh ;
    skos:broader dmtc:BloodGlucoseLowering ;
    skos:closeMatch mesh:D001645 ;
    skos:definition "Derivatives of biguanide (the structure formula HN(C(NH)NH2)2) that are primarily used as oral HYPOGLYCEMIC AGENTS for the treatment of DIABETES MELLITUS, TYPE 2 and PREDIABETES."@en ;
    skos:editorialNote "Japanese label curated, pending native-speaker review; Chinese label curated, pending native-speaker review."@en ;
    skos:exactMatch atc:A10BA ;
    skos:inScheme <https://dgg32.github.io/glp/vocab/therapeutic-class> ;
    skos:notation "A10BA" ;
    skos:prefLabel "Biguanides"@en,
        "ビグアナイド薬"@ja,
        "双胍类药物"@zh .

