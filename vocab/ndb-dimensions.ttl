setting:inpatient a skos:Concept,
        dm:CareSetting ;
    rdfs:label "inpatient"@en,
        "入院"@ja,
        "住院"@zh ;
    skos:definition "Drugs used during a hospital stay."@en ;
    skos:inScheme <https://dgg32.github.io/glp/vocab/care-setting> ;
    skos:prefLabel "inpatient"@en,
        "入院"@ja,
        "住院"@zh ;
    skos:topConceptOf <https://dgg32.github.io/glp/vocab/care-setting> .

setting:outpatient-external a skos:Concept,
        dm:CareSetting ;
    rdfs:label "outpatient, community pharmacy"@en,
        "外来（院外）"@ja,
        "门诊（院外处方）"@zh ;
    skos:broader setting:outpatient ;
    skos:definition "Outpatient prescription filled at a community pharmacy (院外処方, the usual case in Japan)."@en ;
    skos:inScheme <https://dgg32.github.io/glp/vocab/care-setting> ;
    skos:prefLabel "outpatient, community pharmacy"@en,
        "外来（院外）"@ja,
        "门诊（院外处方）"@zh .

setting:outpatient-internal a skos:Concept,
        dm:CareSetting ;
    rdfs:label "outpatient, dispensed in-house"@en,
        "外来（院内）"@ja,
        "门诊（院内处方）"@zh ;
    skos:broader setting:outpatient ;
    skos:definition "Outpatient prescription dispensed by the clinic or hospital itself (院内処方)."@en ;
    skos:inScheme <https://dgg32.github.io/glp/vocab/care-setting> ;
    skos:prefLabel "outpatient, dispensed in-house"@en,
        "外来（院内）"@ja,
        "门诊（院内处方）"@zh .

